@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState

<div class="app-shell">
    <main class="app-content">
        @Body
    </main>

    <AuthorizeView>
        <Authorized>
            <nav class="bottom-nav">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                    <span class="nav-icon">🏠</span><span class="nav-label">홈</span>
                </NavLink>
                <NavLink href="/records" class="nav-item">
                    <span class="nav-icon">📚</span><span class="nav-label">기록</span>
                </NavLink>
                <NavLink href="/my" class="nav-item">
                    <span class="nav-icon">👤</span><span class="nav-label">MY</span>
                </NavLink>
                @if (isAdmin)
                {
                    <NavLink href="/admin" Match="NavLinkMatch.Prefix" class="nav-item">
                        <span class="nav-icon">⚙️</span><span class="nav-label">관리자</span>
                    </NavLink>
                }
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        isAdmin = state.User.IsInRole("ADMIN");
    }
}
