@inherits LayoutComponentBase
@inject ISettingService Settings
@inject AuthenticationStateProvider AuthState

<div class="app-shell">
    <header class="app-header">
        <span class="app-title">@clubName</span>
    </header>

    <main class="app-content">
        @Body
    </main>

    <AuthorizeView>
        <Authorized>
            <nav class="bottom-nav">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                    <span class="nav-icon">🏠</span><span class="nav-label">홈</span>
                </NavLink>
                <NavLink href="/teams" class="nav-item">
                    <span class="nav-icon">🏐</span><span class="nav-label">팀</span>
                </NavLink>
                <NavLink href="/ranking" class="nav-item">
                    <span class="nav-icon">🏆</span><span class="nav-label">순위</span>
                </NavLink>
                <NavLink href="/fees" class="nav-item">
                    <span class="nav-icon">💰</span><span class="nav-label">회비</span>
                </NavLink>
                <NavLink href="/my" class="nav-item">
                    <span class="nav-icon">👤</span><span class="nav-label">MY</span>
                </NavLink>
                @if (isAdmin)
                {
                    <NavLink href="/admin" Match="NavLinkMatch.Prefix" class="nav-item">
                        <span class="nav-icon">⚙️</span><span class="nav-label">관리자</span>
                    </NavLink>
                }
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string clubName = "🏐 배구부";
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        clubName = await Settings.GetClubDisplayNameAsync();
        var state = await AuthState.GetAuthenticationStateAsync();
        isAdmin = state.User.IsInRole("ADMIN");
    }
}
