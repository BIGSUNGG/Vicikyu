@page "/my"
@attribute [Authorize]

@inject IMemberService Members
@inject IAttendanceService Attendance
@inject ICurrentUserService Me

<PageTitle>MY · 배구부</PageTitle>

<header class="hero-band">
    <div class="hf-title">@(profile?.Name ?? "")</div>
    <div class="hf-chips">
        <span class="hf-chip">@(profile?.StudentNumber) · @(profile?.Department)</span>
        <span class="hf-chip">@(profile?.Role == "ADMIN" ? "회장/관리자" : "부원")</span>
        <span class="hf-chip">가입일 @Domain.KstClock.ToKstDateString(profile?.JoinedAt ?? DateTime.MinValue)</span>
    </div>
</header>

@if (semesterStats is not null)
{
    <div class="card">
        <div class="ring-wrap">
            <div class="ring" style="background:conic-gradient(var(--vb-success) 0 @semesterStats.AttendanceRatePercent%, #f0e6d8 @semesterStats.AttendanceRatePercent% 100%)">
                <div class="ring-in">
                    <div class="ring-num">@semesterStats.AttendanceRatePercent%</div>
                    <div class="ring-label">출석률</div>
                </div>
            </div>
            <div class="ring-side">
                <div class="ring-stat">
                    <div class="rs-icon">🏆</div>
                    <div>
                        <div class="rs-label">현재 순위</div>
                        <div class="rs-value">@(semesterStats.Rank)위 / @(semesterStats.TotalActiveMembers)명</div>
                    </div>
                </div>
                <div class="ring-stat">
                    <div class="rs-icon">📅</div>
                    <div>
                        <div class="rs-label">이번 학기 출석</div>
                        <div class="rs-value">@(semesterStats.MyAttendances)회 (@(semesterStats.SemesterActivities)회 중)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="cal-nav">
        <button type="button" class="btn-ghost btn-sm" style="width:auto" @onclick="() => ShiftMonth(-1)">◀</button>
        <span class="cal-title">@(calendar.Year)년 @(calendar.Month)월</span>
        <button type="button" class="btn-ghost btn-sm" style="width:auto" @onclick="() => ShiftMonth(1)">▶</button>
    </div>

    <table class="calendar">
        <tr>
            <th class="sun">일</th><th>월</th><th>화</th><th>수</th><th>목</th><th>금</th><th>토</th>
        </tr>
        @for (var week = 0; week < weeks.Count; week++)
        {
            <tr>
                @for (var day = 0; day < 7; day++)
                {
                    var cell = weeks[week][day];
                    <td>
                        @if (cell is not null)
                        {
                            var selected = selectedDay?.Date == cell.Date;
                            <button type="button"
                                    class="day-cell @(cell.IsAttended ? "attended" : "") @(selected ? "selected" : "")"
                                    @onclick="() => SelectDay(cell)">
                                @cell.Date.Day
                                @if (cell.IsAttended)
                                {
                                    <span class="mark">✔</span>
                                }
                            </button>
                        }
                    </td>
                }
            </tr>
        }
    </table>

    @if (selectedDay is { } sel)
    {
        <div class="day-detail">
            <div class="dd-date">@sel.Date.ToString("yyyy년 M월 d일 dddd")</div>
            @if (sel.IsAttended)
            {
                <div class="dd-info">
                    ✅ 출석 — @Domain.KstClock.ToKstTimeString(sel.CheckedAt ?? DateTime.MinValue)
                    @(sel.TeamName is not null ? $" · {sel.TeamName}" : "")
                </div>
            }
            else
            {
                <div class="dd-info">기록 없음</div>
            }
        </div>
    }

    <div class="btn-row" style="margin-top:14px">
        <div class="card" style="margin:0;text-align:center;padding:12px 8px">
            <div class="card-title" style="margin-bottom:4px">이번 달</div>
            <div class="card-value" style="font-size:1.2rem">@(calendar.MonthCount)회</div>
        </div>
        <div class="card" style="margin:0;text-align:center;padding:12px 8px">
            <div class="card-title" style="margin-bottom:4px">이번 학기</div>
            <div class="card-value" style="font-size:1.2rem">@(calendar.SemesterCount)회</div>
        </div>
    </div>
    <div style="text-align:center;margin-top:10px">
        <span class="member-meta">전체 @(calendar.TotalCount)회</span>
    </div>
</div>

<div class="btn-row">
    <a href="/Account/Logout" class="btn-ghost">로그아웃</a>
    <AuthorizeView Roles="ADMIN">
        <a href="/admin" class="btn-secondary">⚙ 관리자</a>
    </AuthorizeView>
</div>

@code {
    private ProfileDto? profile;
    private MySemesterStatsDto? semesterStats;
    private MyCalendarDto calendar = new(0, 0, [], 0, 0, 0);
    private CalendarDayDto? selectedDay;
    private List<CalendarDayDto?[]> weeks = [];
    private string myUserId = "";
    private int year = DateTime.Now.Year;
    private int month = DateTime.Now.Month;

    protected override async Task OnInitializedAsync()
    {
        myUserId = await Me.RequireUserIdAsync();
        profile = await Members.GetProfileAsync(myUserId);
        semesterStats = await Attendance.GetMySemesterStatsAsync(myUserId);
        (year, month) = (DateTime.Now.Year, DateTime.Now.Month);
        await LoadCalendarAsync();
    }

    private async Task LoadCalendarAsync()
    {
        calendar = await Attendance.GetMyCalendarAsync(myUserId, year, month);
        selectedDay = null;
        weeks = BuildWeeks(year, month, calendar.Days);
    }

    private static List<CalendarDayDto?[]> BuildWeeks(int year, int month, List<CalendarDayDto> attendedDays)
    {
        var first = new DateOnly(year, month, 1);
        var daysInMonth = DateTime.DaysInMonth(year, month);
        var byDate = attendedDays.ToDictionary(d => d.Date);
        var cells = new List<CalendarDayDto?>();
        for (var i = 0; i < (int)first.DayOfWeek; i++)
        {
            cells.Add(null);
        }

        for (var day = 1; day <= daysInMonth; day++)
        {
            var date = new DateOnly(year, month, day);
            cells.Add(byDate.TryGetValue(date, out var dto) ? dto : new CalendarDayDto(date, false, null, null));
        }

        while (cells.Count % 7 != 0)
        {
            cells.Add(null);
        }

        return cells.Chunk(7).Select(chunk => chunk.Cast<CalendarDayDto?>().ToArray()).ToList();
    }

    private async Task ShiftMonth(int delta)
    {
        var date = new DateTime(year, month, 1).AddMonths(delta);
        (year, month) = (date.Year, date.Month);
        await LoadCalendarAsync();
    }

    private void SelectDay(CalendarDayDto day) => selectedDay = day;
}
