@page "/fees"
@attribute [Authorize]

@inject IFeeService FeeSvc
@inject ISettingService Settings
@inject ICurrentUserService Me

<PageTitle>회비 · 배구부</PageTitle>

<h1 class="page-title">💰 회비</h1>

@if (current is not null)
{
    <FeeStatusCard Status="current" />
}

@if (!string.IsNullOrEmpty(sheetUrl))
{
    <a href="@sheetUrl" target="_blank" rel="noopener noreferrer" class="btn-secondary btn-block" style="margin-bottom:14px">
        📄 회비 사용 내역 보기
    </a>
}

<div class="card">
    <h2 class="card-title">납부 이력</h2>
    @if (statuses.Count == 0)
    {
        <p class="empty">회비 기간이 없습니다.</p>
    }
    else
    {
        <div class="card-list">
            @foreach (var status in statuses)
            {
                <div class="member-row" style="cursor:default">
                    <div>
                        <div class="member-name">@status.PeriodName</div>
                        @if (status.IsPaid && status.PaidAt is { } paidAt)
                        {
                            <div class="member-meta">납부일 @Domain.KstClock.ToKstDateString(paidAt)</div>
                        }
                    </div>
                    @if (status.IsPaid)
                    {
                        <span class="member-time">✅ 납부</span>
                    }
                    else
                    {
                        <span class="badge badge-red">❌ 미납</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<FeeStatusDto> statuses = [];
    private FeeStatusDto? current;
    private string? sheetUrl;

    protected override async Task OnInitializedAsync()
    {
        var userId = await Me.RequireUserIdAsync();
        statuses = await FeeSvc.GetMyStatusesAsync(userId);
        var period = await FeeSvc.GetCurrentPeriodAsync();
        current = period is null ? null : statuses.FirstOrDefault(s => s.PeriodId == period.Id);
        sheetUrl = await Settings.GetFeeSheetUrlAsync();
    }
}
