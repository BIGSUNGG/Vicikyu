@page "/admin/teams"
@attribute [Authorize(Roles = "ADMIN")]

@inject ITeamService TeamSvc
@inject ISettingService Settings
@inject ISnackbar Snackbar

<PageTitle>팀 뽑기 · 배구부</PageTitle>

<AdminNav Title="🎲 팀 뽑기" Sub="출석 인원 기준 랜덤 편성" Active="teams" />

@if (drawnTeams is { Count: > 0 })
{
    <div class="card">
        <div class="card-row">
                <h2 class="card-title" style="margin:0">편성 결과</h2>
                <span class="badge badge-orange">@(drawnTeams[0].DrawNumber)회차 · @(selectedUserIds.Count)명 참가</span>
            </div>
    </div>

    @foreach (var team in drawnTeams)
    {
        <TeamCard Team="team" Selectable="true" OnMemberSelected="SelectMemberAsync" />
    }

    <div class="card">
        <div class="card-row">
            <h2 class="card-title" style="margin:0">➕ 누락 인원 추가</h2>
            <span class="badge badge-gray">@(UnassignedParticipants.Count)명</span>
        </div>
        @if (UnassignedParticipants.Count > 0)
        {
            <div class="card-list">
                @foreach (var p in UnassignedParticipants)
                {
                    <button type="button" class="member-row" @onclick="() => StartAddMember(p)">
                        <div>
                            <div class="member-name">@p.Name@(p.IsGuest ? " (게스트)" : "")</div>
                            <div class="member-meta">@p.Department</div>
                        </div>
                        <span class="member-time">＋</span>
                    </button>
                }
            </div>
        }
        @* 편성 후에도 게스트를 바로 등록해 누락 목록에서 팀에 배정할 수 있다 *@
        <div style="margin-top:10px">
            <input class="form-control" type="text" placeholder="게스트 이름" value="@newGuestName"
                   @oninput='e => newGuestName = e.Value?.ToString() ?? ""' />
            <div style="height:8px"></div>
            <button type="button" class="btn-secondary btn-sm" @onclick="AddGuestAsync">+ 게스트 추가</button>
        </div>
    </div>

    @if (movingMember is not null)
    {
        <div class="confirm-overlay" @onclick="() => movingMember = null">
            <div class="confirm-box" @onclick:stopPropagation>
                <h3>@movingMember.Name 팀 이동</h3>
                <div class="card-list" style="margin-bottom:16px">
                    @foreach (var team in drawnTeams)
                    {
                        <label class="member-row">
                            <input type="radio" name="moveTarget" checked="@(moveTargetTeamId == team.TeamId)"
                                   @onchange="() => moveTargetTeamId = team.TeamId" />
                            <span class="member-name">@team.Name (@(team.Members.Count)명)</span>
                        </label>
                    }
                </div>
                <div class="btn-row">
                    <button type="button" class="btn-ghost" @onclick="() => movingMember = null">취소</button>
                    <button type="button" class="btn-secondary" @onclick="RemoveMemberAsync">팀에서 제거</button>
                    <button type="button" class="btn-primary" @onclick="MoveMemberAsync">이동</button>
                </div>
            </div>
        </div>
    }

    <div class="btn-row">
        <button type="button" class="btn-secondary" @onclick="RedrawAsync">🔄 다시 뽑기</button>
        @if (canConfirm)
        {
            <button type="button" class="btn-primary" @onclick="ConfirmAsync">팀 편성 확정</button>
        }
    </div>
    <button type="button" class="btn-ghost btn-block" @onclick="() => showCancelDraw = true">🗑 @(drawnTeams[0].DrawNumber)회차 취소</button>
    <div style="height:8px"></div>
}
else
{
    <div class="card">
        <div class="section-divider">오늘 출석 @(participants.AttendedCount)명</div>
        <div class="card-list">
            @foreach (var p in participants.Participants)
            {
                <label class="member-row">
                    <input type="checkbox"
                           checked="@(p.IsGuest ? selectedGuestIds.Contains(p.GuestId!.Value) : selectedUserIds.Contains(p.UserId!))"
                           @onchange="e => ToggleParticipant(p, (bool)e.Value!)" />
                    <div>
                        <div class="member-name">@p.Name@(p.IsGuest ? " (게스트)" : "")</div>
                        <div class="member-meta">@p.Department</div>
                    </div>
                    @if (p.IsAttended && !p.IsGuest)
                    {
                        <span class="member-time">✅ 출석</span>
                    }
                </label>
            }
        </div>

        <div style="margin-top:10px">
            <input class="form-control" type="text" placeholder="게스트 이름" value="@newGuestName"
                   @oninput='e => newGuestName = e.Value?.ToString() ?? ""' />
            <div style="height:8px"></div>
            <button type="button" class="btn-secondary btn-sm" @onclick="AddGuestAsync">+ 게스트 추가</button>
        </div>
    </div>

    <div class="card">
        <h2 class="card-title">팀 수 · 팀별 인원</h2>
        <div class="filter-group">
            @foreach (var n in new[] { 2, 3, 4, 5 })
            {
                <button type="button" class="filter-btn @(teamCount == n ? "active" : "")" @onclick="() => SetTeamCount(n)">@(n)팀</button>
            }
        </div>

        <div class="card-row" style="margin-bottom:10px">
            <span style="font-weight:700">팀 수 직접 입력</span>
            <input class="form-control" type="number" min="2" max="10" style="width:90px;text-align:center"
                   value="@teamCount" @onchange="e => SetTeamCount(int.TryParse(e.Value?.ToString(), out var n) ? n : teamCount)" />
        </div>

        @for (var i = 0; i < teamSizes.Count; i++)
        {
            var index = i;
            <div class="card-row" style="padding:5px 0">
                <span style="font-weight:700">@((char)('A' + index))팀</span>
                <input class="form-control" type="number" min="1" style="width:90px;text-align:center"
                       value="@teamSizes[index]" @onchange="e => SetTeamSize(index, e.Value?.ToString())" />
            </div>
        }

        <p class="member-meta" style="margin-top:8px">
            총 선택 인원: @(selectedUserIds.Count + selectedGuestIds.Count)명 · 팀별 합계: @(teamSizes.Sum())명
        </p>
        @if (sizeError is not null)
        {
            <p class="text-danger">@sizeError</p>
        }

        <button type="button" class="btn-primary btn-block" style="margin-top:10px" @onclick="DrawAsync">🎲 랜덤 팀 뽑기</button>
    </div>
}

@if (showRedrawConfirm)
{
    <div class="confirm-overlay" @onclick="() => showRedrawConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>다시 뽑기</h3>
            <p>팀을 다시 뽑으면 현재 팀 편성이 초기화됩니다. 계속하시겠습니까?</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showRedrawConfirm = false">취소</button>
                <button type="button" class="btn-primary" @onclick="BackToSelection">다시 뽑기</button>
            </div>
        </div>
    </div>
}

@if (showCancelDraw)
{
    <div class="confirm-overlay" @onclick="() => showCancelDraw = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>@(drawnTeams.Count > 0 ? $"{drawnTeams[0].DrawNumber}회차 취소" : "회차 취소")</h3>
            <p>이 회차의 팀 편성과 배정 기록이 삭제됩니다.
                @if (confirmedDraw == (drawnTeams.Count > 0 ? drawnTeams[0].DrawNumber : 0))
                {
                    if (confirmedDraw is null || confirmedDraw <= 1)
                    {
                        <text>부원에게는 더 이상 팀이 표시되지 않습니다.</text>
                    }
                    else
                    {
                        <text>부원에게는 이전 확정 회차가 다시 표시됩니다.</text>
                    }
                }
                계속하시겠습니까?</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showCancelDraw = false">취소</button>
                <button type="button" class="btn-primary" @onclick="CancelDrawAsync">회차 취소</button>
            </div>
        </div>
    </div>
}

@if (addingParticipant is not null)
{
    <div class="confirm-overlay" @onclick="() => addingParticipant = null">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>@addingParticipant.Name 배정할 팀</h3>
            <div class="card-list" style="margin-bottom:16px">
                @foreach (var team in drawnTeams)
                {
                    <label class="member-row">
                        <input type="radio" name="addTarget" checked="@(addTargetTeamId == team.TeamId)"
                               @onchange="() => addTargetTeamId = team.TeamId" />
                        <span class="member-name">@team.Name (@(team.Members.Count)명)</span>
                    </label>
                }
            </div>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => addingParticipant = null">취소</button>
                <button type="button" class="btn-primary" @onclick="AddMemberAsync">추가</button>
            </div>
        </div>
    </div>
}

@if (showConfirmDialog)
{
    <div class="confirm-overlay" @onclick="() => showConfirmDialog = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>팀 편성 확정</h3>
            <p>확정하면 모든 부원이 자기 팀을 확인할 수 있습니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showConfirmDialog = false">취소</button>
                <button type="button" class="btn-primary" @onclick="DoConfirmAsync">확정</button>
            </div>
        </div>
    </div>
}

@code {
    private ParticipantListDto participants = new([], 0);
    private HashSet<string> selectedUserIds = [];
    private HashSet<int> selectedGuestIds = [];
    private int teamCount = 3;
    private List<int> teamSizes = [];
    private List<TeamResultDto> drawnTeams = [];
    private TeamMemberDto? movingMember;
    private int moveTargetTeamId;
    private int? confirmedDraw;
    private ParticipantDto? addingParticipant;
    private int addTargetTeamId;
    private bool showRedrawConfirm;
    private bool showCancelDraw;
    private bool showConfirmDialog;
    private string newGuestName = "";
    private string? sizeError;

    protected override async Task OnInitializedAsync()
    {
        teamCount = await Settings.GetIntAsync("DefaultTeamCount", 3);
        await LoadParticipantsAsync();

        // 이미 편성되어 있으면 최신 회차를 표시. 확정된 회차와 다르면 재확정 대상.
        drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
        confirmedDraw = await TeamSvc.GetConfirmedDrawNumberAsync();
        if (drawnTeams.Count > 0)
        {
            SyncSelectionFromTeams();
        }
        else
        {
            SetTeamCount(teamCount);
        }
    }

    /// <summary>최신 회차가 아직 확정되지 않았을 때만 확정 버튼을 노출한다.</summary>
    private bool canConfirm => drawnTeams.Count > 0 && drawnTeams[0].DrawNumber != confirmedDraw;

    private async Task LoadParticipantsAsync()
    {
        try
        {
            participants = await TeamSvc.GetParticipantsAsync();
            selectedUserIds = participants.Participants.Where(p => !p.IsGuest).Select(p => p.UserId!).ToHashSet();
            selectedGuestIds = participants.Participants.Where(p => p.IsGuest).Select(p => p.GuestId!.Value).ToHashSet();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void SyncSelectionFromTeams()
    {
        selectedUserIds = drawnTeams.SelectMany(t => t.Members).Where(m => !m.IsGuest).Select(m => m.UserId!).ToHashSet();
        selectedGuestIds = drawnTeams.SelectMany(t => t.Members).Where(m => m.IsGuest).Select(m => m.GuestId!.Value).ToHashSet();
        var groups = drawnTeams.Select(t => t.Members.Count).Where(c => c > 0).ToList();
        if (groups.Count > 0)
        {
            teamCount = groups.Count;
            teamSizes = groups;
        }
    }

    private void ToggleParticipant(ParticipantDto p, bool value)
    {
        if (p.IsGuest)
        {
            if (value)
            {
                selectedGuestIds.Add(p.GuestId!.Value);
            }
            else
            {
                selectedGuestIds.Remove(p.GuestId!.Value);
            }
        }
        else
        {
            if (value)
            {
                selectedUserIds.Add(p.UserId!);
            }
            else
            {
                selectedUserIds.Remove(p.UserId!);
            }
        }

        ValidateSizes();
    }

    private void SetTeamCount(int n)
    {
        teamCount = Math.Clamp(n, 2, 10);
        var total = selectedUserIds.Count + selectedGuestIds.Count;
        teamSizes = Enumerable.Range(0, teamCount)
            .Select(i => total / teamCount + (i < total % teamCount ? 1 : 0))
            .ToList();
        ValidateSizes();
    }

    private void SetTeamSize(int index, string? value)
    {
        if (int.TryParse(value, out var size) && index >= 0 && index < teamSizes.Count)
        {
            teamSizes[index] = Math.Max(1, size);
        }

        ValidateSizes();
    }

    private void ValidateSizes()
    {
        var total = selectedUserIds.Count + selectedGuestIds.Count;
        sizeError = teamSizes.Any(s => s < 1)
            ? "팀별 인원수는 1 이상이어야 합니다."
            : teamSizes.Sum() != total
                ? $"팀별 인원수 합계가 참가 인원 {total}명과 일치하지 않습니다."
                : null;
    }

    private async Task DrawAsync()
    {
        ValidateSizes();
        if (sizeError is not null)
        {
            Snackbar.Add(sizeError, Severity.Warning);
            return;
        }

        try
        {
            drawnTeams = await TeamSvc.GenerateAsync(new TeamCreateRequest(selectedUserIds.ToList(), selectedGuestIds.ToList(), teamSizes.ToList()));
            Snackbar.Add($"{drawnTeams[0].DrawNumber}회차 팀을 편성했습니다. 확인 후 확정해 주세요.", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void RedrawAsync() => showRedrawConfirm = true;

    private Task BackToSelection()
    {
        showRedrawConfirm = false;
        drawnTeams = [];
        return Task.CompletedTask;
    }

    private void SelectMemberAsync(TeamMemberDto member)
    {
        movingMember = member;
        moveTargetTeamId = drawnTeams.FirstOrDefault(t => t.TeamId == drawnTeams.FirstOrDefault(x => x.Members.Any(m => m.TeamMemberId == member.TeamMemberId))?.TeamId)?.TeamId
            ?? drawnTeams.FirstOrDefault()?.TeamId ?? 0;
    }

    /// <summary>최신 회차에 배정되지 않은 참가자(누락 인원·게스트).</summary>
    private List<ParticipantDto> UnassignedParticipants
    {
        get
        {
            var assigned = drawnTeams.SelectMany(t => t.Members)
                .Select(m => m.IsGuest ? $"g:{m.GuestId}" : $"u:{m.UserId}")
                .ToHashSet();
            return participants.Participants.Where(p => !assigned.Contains(p.Key)).ToList();
        }
    }

    private void StartAddMember(ParticipantDto p)
    {
        addingParticipant = p;
        addTargetTeamId = drawnTeams.FirstOrDefault()?.TeamId ?? 0;
    }

    private async Task AddMemberAsync()
    {
        var p = addingParticipant;
        addingParticipant = null;
        if (p is null)
        {
            return;
        }

        try
        {
            await TeamSvc.AddMemberAsync(p.Key, addTargetTeamId);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
            Snackbar.Add($"{p.Name} 배정 완료", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
        }
    }

    private async Task RemoveMemberAsync()
    {
        var member = movingMember;
        movingMember = null;
        if (member is null)
        {
            return;
        }

        try
        {
            await TeamSvc.RemoveMemberAsync(member.TeamMemberId);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
            await LoadParticipantsAsync();
            Snackbar.Add($"{member.Name} 팀에서 제거", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
        }
    }

    private async Task CancelDrawAsync()
    {
        showCancelDraw = false;
        var drawNumber = drawnTeams.Count > 0 ? drawnTeams[0].DrawNumber : 0;
        try
        {
            await TeamSvc.CancelLatestDrawAsync();
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
            confirmedDraw = await TeamSvc.GetConfirmedDrawNumberAsync();
            await LoadParticipantsAsync();
            Snackbar.Add($"{drawNumber}회차 편성을 취소했습니다.", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MoveMemberAsync()
    {
        if (movingMember is null)
        {
            return;
        }

        var member = movingMember;
        movingMember = null;
        try
        {
            await TeamSvc.MoveMemberAsync(member.TeamMemberId, moveTargetTeamId);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
            Snackbar.Add($"{member.Name} 이동 완료", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
        }
    }

    private void ConfirmAsync() => showConfirmDialog = true;

    private async Task DoConfirmAsync()
    {
        showConfirmDialog = false;
        try
        {
            await TeamSvc.ConfirmAsync();
            confirmedDraw = drawnTeams[0].DrawNumber;
            Snackbar.Add($"{confirmedDraw}회차 팀 편성이 확정되었습니다. 부원에게 공개됩니다.", Severity.Success);
            drawnTeams = await TeamSvc.GetTodayTeamsForAdminAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AddGuestAsync()
    {
        var name = newGuestName.Trim();
        if (name.Length == 0)
        {
            Snackbar.Add("게스트 이름을 입력해 주세요.", Severity.Warning);
            return;
        }

        try
        {
            await TeamSvc.AddGuestAsync(name);
            newGuestName = "";
            Snackbar.Add($"게스트 '{name}' 추가", Severity.Success);
            await LoadParticipantsAsync();
            SetTeamCount(teamCount);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
