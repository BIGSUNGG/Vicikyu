@page "/"
@attribute [Authorize]

@inject IActivityService Activities
@inject IAttendanceService Attendance
@inject ITeamService Teams
@inject IFeeService Fees
@inject ICurrentUserService Me

<PageTitle>홈 · 배구부</PageTitle>

<h1 class="page-title">@DateString</h1>

@if (today is not null)
{
    <div class="card">
        <div class="card-row">
            <div>
                <div class="card-value">오늘 운동</div>
                <div class="member-meta">@today.ActivityDate.ToString("yyyy년 M월 d일 dddd")</div>
            </div>
            <span class="badge @(StatusBadgeClass)">@today.StatusText</span>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-row">
            <div class="card-value">오늘 운동</div>
            <span class="badge badge-gray">일정 없음</span>
        </div>
        <p class="empty">오늘은 활동이 없습니다.</p>
    </div>
}

<AttendanceStatusCard Today="today" OnChanged="LoadAsync" />

@if (myTeam is not null)
{
    <div class="card">
        <h2 class="card-title">🏐 오늘 나는</h2>
        <div class="card-value" style="color:var(--vb-primary-dark)">@myTeam.Name</div>
        <div style="margin-top:8px">
            @foreach (var teammate in myTeam.Members)
            {
                var isMine = !teammate.IsGuest && teammate.UserId == myUserId;
                <span class="team-member-chip @(isMine ? "mine" : "")">@teammate.Name@(teammate.IsGuest ? " (게스트)" : "")@(isMine ? " ★" : "")</span>
            }
        </div>
        <a href="/teams" class="btn-ghost btn-block" style="margin-top:12px">전체 팀 보기</a>
    </div>
}

@if (semesterStats is not null)
{
    <div class="card">
        <h2 class="card-title">🏆 이번 학기 내 출석</h2>
        <div class="card-row">
            <span class="card-value">@(semesterStats.MyAttendances)회</span>
            <span class="badge badge-blue">현재 @(semesterStats.Rank)위 / @(semesterStats.TotalActiveMembers)명</span>
        </div>
        <div class="member-meta" style="margin-top:6px">출석률 @semesterStats.AttendanceRatePercent% (활동 @(semesterStats.SemesterActivities)회 중)</div>
    </div>
}

@if (feeStatus is not null)
{
    <FeeStatusCard Status="feeStatus" />
}

@code {
    private MyTodayDto? today;
    private TeamResultDto? myTeam;
    private MySemesterStatsDto? semesterStats;
    private FeeStatusDto? feeStatus;
    private string myUserId = "";

    private string DateString => DateTime.Now.ToString("yyyy년 M월 d일 dddd");

    private string StatusBadgeClass => today?.Status switch
    {
        ActivityStatus.AttendanceOpen => "badge-green",
        ActivityStatus.ActivityClosed => "badge-red",
        ActivityStatus.TeamCreated => "badge-orange",
        _ => "badge-gray",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        myUserId = await Me.RequireUserIdAsync();
        try
        {
            today = await Activities.GetMyTodayAsync(myUserId);
        }
        catch (NotFoundException)
        {
            today = null;
        }

        var teams = await Teams.GetTodayTeamsAsync();
        myTeam = teams.FirstOrDefault(t => t.Members.Any(m => m.UserId == myUserId));

        semesterStats = await Attendance.GetMySemesterStatsAsync(myUserId);

        var period = await Fees.GetCurrentPeriodAsync();
        if (period is not null)
        {
            var myStatuses = await Fees.GetMyStatusesAsync(myUserId);
            feeStatus = myStatuses.FirstOrDefault(s => s.PeriodId == period.Id);
        }
    }
}
