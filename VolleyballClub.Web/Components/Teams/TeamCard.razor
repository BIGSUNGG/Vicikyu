@* 코트 카드(L1 시안 team.html) — 관리자 팀 뽑기용. 멤버 칩은 항상 펼침(클릭 → 이동/제거). *@
<div class="court open">
    <div class="court-head">
        <span class="court-name">🏐 @Team.Name</span>
        <span class="badge @(IsMineTeam ? "badge-orange" : "badge-gray")">@(Team.Members.Count)명</span>
    </div>
    <div class="chips-wrap">
        <div class="chips">
        @foreach (var member in Team.Members)
        {
            var isMine = !member.IsGuest && member.UserId == MyUserId;
            <button type="button"
                    class="team-member-chip @(isMine ? "mine" : "") @(Selectable ? "clickable" : "")"
                    @onclick="() => SelectMember(member)">
                @member.Name@(member.IsGuest ? " (게스트)" : "")@(isMine ? " ★" : "")
            </button>
        }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TeamResultDto Team { get; set; } = null!;

    [Parameter]
    public string? MyUserId { get; set; }

    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public EventCallback<TeamMemberDto> OnMemberSelected { get; set; }

    private bool IsMineTeam => MyUserId is not null
        && Team.Members.Any(m => !m.IsGuest && m.UserId == MyUserId);

    private async Task SelectMember(TeamMemberDto member)
    {
        if (Selectable)
        {
            await OnMemberSelected.InvokeAsync(member);
        }
    }
}
