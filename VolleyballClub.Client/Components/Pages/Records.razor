@page "/records"
@attribute [Authorize]

@inject AttendanceClient Attendance
@inject Microsoft.Extensions.Logging.ILogger<Records> Logger
@using Microsoft.Extensions.Logging

<PageTitle>기록 · 빅이큐</PageTitle>

<header class="hero-band" data-load-state="@LoadState">
    <div class="hf-title" aria-busy="@(isLoading ? "true" : "false")">
        @if (isLoading) { <span class="loading-placeholder" aria-hidden="true">&nbsp;</span> }
        else if (loadError is not null) { <text>기록</text> }
        else { <text>@(records.Month)월 @(records.MonthCount)회 출석</text> }
    </div>
    <div class="hf-chips">
        @if (isLoading)
        {
            <span class="hf-chip" role="status">기록을 불러오는 중…</span>
        }
        else if (loadError is null)
        {
            <span class="hf-chip">활동 @(records.MonthActivities)회 중</span>
        }
        else
        {
            <span class="hf-chip">기록 조회 실패</span>
        }
        @if (semesterStats is not null)
        {
            <span class="hf-chip">출석률 @(semesterStats.AttendanceRatePercent)%</span>
        }
    </div>
</header>

<div class="card records-card" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
    <div class="cal-nav">
        <button type="button" class="btn-ghost btn-sm" style="width:auto" aria-label="이전 달" @onclick="() => ShiftMonth(-1)">◀</button>
        <span class="cal-title">@(year)년 @(month)월</span>
        <button type="button" class="btn-ghost btn-sm" style="width:auto" aria-label="다음 달" @onclick="() => ShiftMonth(1)">▶</button>
    </div>

    <div class="records-results">
    @if (isLoading)
    {
        <div class="records-skeleton" data-retained="@(records.Year != 0 ? "true" : "false")" aria-hidden="true">
            @if (records.Year != 0 && records.Records.Count == 0)
            {
                <p class="empty"><span class="loading-placeholder">&nbsp;</span></p>
            }
            else
            {
                <div class="tl loading-timeline" style="margin-top:8px">
                    @for (var i = 0; i < (records.Year != 0 ? records.Records.Count : 3); i++)
                    {
                        <div class="tl-item">
                            <div class="tl-dot neutral"><img class="icon" src="/icons/volleyball.svg" alt=""></div>
                            <div class="tl-time"><span class="loading-placeholder">&nbsp;</span></div>
                            <div class="tl-title"><span class="loading-placeholder">&nbsp;</span></div>
                            <div class="tl-desc"><span class="loading-placeholder">&nbsp;</span></div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (!isLoading || records.Year != 0)
    {
    <div class="records-values" aria-hidden="@(isLoading ? "true" : "false")">
    @if (loadError is not null)
    {
        <div role="alert">
            <p>@loadError</p>
            <button type="button" class="btn-primary" @onclick="LoadAsync">다시 불러오기</button>
        </div>
    }
    else if (records.Records.Count == 0)
    {
        <p class="empty">이 달에 활동 기록이 없습니다.</p>
    }
    else
    {
        <div class="tl" style="margin-top:8px">
            @foreach (var record in records.Records)
            {
                <div class="tl-item" @key="@($"row-{record.ActivityId}")">
                    <div class="tl-dot neutral"><img class="icon" src="/icons/volleyball.svg" alt=""></div>
                    <div class="tl-time">@record.Date.ToString("M월 d일 dddd")</div>
                    <div class="tl-title">
                        @(record.IsAttended ? "출석 완료" : "미출석")
                        <span class="badge @StatusBadgeClass(record.Status)">@StatusText(record.Status)</span>
                    </div>
                    <div class="tl-desc">
                        @if (record.IsAttended)
                        {
                            <text><img class="icon" src="/icons/check.svg" alt=""> 출석 @Domain.KstClock.ToKstTimeString(record.CheckedAt!.Value)</text>
                        }
                        else
                        {
                            <text>출석 기록 없음</text>
                        }
                        @if (record.Status == ActivityStatus.ActivityClosed)
                        {
                            <text> · <img class="icon" src="/icons/finish.svg" alt=""> 활동 종료</text>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
    }
    </div>
</div>

<button type="button" class="more-btn" @onclick="() => ShiftMonth(-1)">이전 달 기록 보기</button>

@code {
    private bool isLoading = true;
    private string? loadError;
    private int loadGeneration;
    private string LoadState => isLoading ? "loading" : loadError is not null ? "error" : "ready";
    private MyRecordsDto records = new(0, 0, [], 0, 0);
    private MySemesterStatsDto? semesterStats;
    private int year;
    private int month;

    protected override async Task OnInitializedAsync()
    {
        var today = Domain.KstClock.Today(TimeProvider.System);
        (year, month) = (today.Year, today.Month);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = ++loadGeneration;
        var (requestedYear, requestedMonth) = (year, month);
        isLoading = true;
        loadError = null;
        try
        {
            var statsTask = semesterStats is null ? Attendance.GetMySemesterStatsAsync() : Task.FromResult(semesterStats);
            var recordsTask = Attendance.GetMyRecordsAsync(requestedYear, requestedMonth);
            await Task.WhenAll(statsTask, recordsTask);
            if (generation != loadGeneration) return;
            var loadedStats = await statsTask ?? throw new InvalidOperationException("학기 통계 응답이 없습니다.");
            var loadedRecords = await recordsTask ?? throw new InvalidOperationException("기록 응답이 없습니다.");
            if (loadedRecords.Records is null || loadedRecords.Year != requestedYear || loadedRecords.Month != requestedMonth)
                throw new InvalidOperationException("요청한 월의 기록 응답이 올바르지 않습니다.");
            semesterStats = loadedStats;
            records = loadedRecords;
        }
        catch (AppException ex)
        {
            if (generation == loadGeneration) loadError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "기록 조회 실패 ({Year}-{Month})", requestedYear, requestedMonth);
            if (generation == loadGeneration) loadError = "기록을 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
        }
        finally
        {
            if (generation == loadGeneration) isLoading = false;
        }
    }

    private async Task ShiftMonth(int delta)
    {
        var date = new DateTime(year, month, 1).AddMonths(delta);
        (year, month) = (date.Year, date.Month);
        await LoadAsync();
    }

    private static string StatusText(ActivityStatus status) => status switch
    {
        ActivityStatus.Ready => "준비 중",
        ActivityStatus.AttendanceOpen => "활동 중",
        ActivityStatus.AttendanceClosed => "출석 마감", // 레거시 상태 — 과거 기록 표시용
        ActivityStatus.TeamCreated => "팀 확정",
        ActivityStatus.ActivityClosed => "종료",
        _ => status.ToString(),
    };

    private static string StatusBadgeClass(ActivityStatus status) => status switch
    {
        ActivityStatus.AttendanceOpen => "badge-green",
        ActivityStatus.ActivityClosed => "badge-gray",
        ActivityStatus.TeamCreated => "badge-orange",
        _ => "badge-gray",
    };
}
