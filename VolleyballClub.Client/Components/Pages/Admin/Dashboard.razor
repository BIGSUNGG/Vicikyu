@page "/admin"
@attribute [Authorize(Roles = "ADMIN")]

@inject ActivityClient Activities
@inject TeamClient Teams
@inject SheetSyncClient SheetSync
@inject ISnackbar Snackbar

<PageTitle>관리자 · 빅이큐</PageTitle>

<AdminNav Icon="/icons/gear.svg" Title="관리자" Sub="@Domain.KstClock.Today(TimeProvider.System).ToDateTime(TimeOnly.MinValue).ToString("yyyy년 M월 d일 dddd")"
          Active="dashboard" Badge="@(today?.StatusText)"
          BadgeClass="@(StatusBadgeClass)" />

<div class="admin-grid">
@if (today is not null)
{
    <div class="card">
        <h2 class="card-title">오늘 운동 · @today.ActivityDate.ToString("yyyy.MM.dd")</h2>
        <div class="card-row" style="margin-bottom:10px">
            <span class="badge @(StatusBadgeClass)">@today.StatusText</span>
            <span style="font-weight:700">오늘 출석 @today.AttendanceCount / @(today.TotalActiveMembers)명</span>
        </div>

        @if (!string.IsNullOrEmpty(today.OtpCode))
        {
            <div style="margin-bottom:12px">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                    <div class="card-title">오늘 OTP · 부원에게 보여주세요</div>
                    <button type="button" class="sec-expand" aria-label="OTP 확대해서 보기" @onclick="() => showOtpZoom = true">⤢</button>
                </div>
                <div class="otp-big">
                    @{ var i = 0; }
                    @foreach (var ch in today.OtpCode)
                    {
                        <span @key="@(i++ + "-" + ch)">@ch</span>
                    }
                </div>
            </div>
        }

        <div class="btn-row">
            @if (today.Status == ActivityStatus.Ready)
            {
                <button type="button" class="btn-primary" @onclick="() => RunAsync(Activities.StartActivityAsync)">활동 시작</button>
            }
            <button type="button" class="btn-primary @(IsActive || today.Status == ActivityStatus.ActivityClosed ? "btn-wide" : "")" @onclick="GenerateOtpAsync">OTP @(string.IsNullOrEmpty(today.OtpCode) ? "생성" : "변경")</button>
            @if (IsActive)
            {
                <button type="button" class="btn-danger" @onclick="ConfirmCancelActivityAsync">활동 취소</button>
                <button type="button" class="btn-danger" @onclick="ConfirmCloseActivityAsync">활동 마감</button>
            }
            @if (today.Status == ActivityStatus.ActivityClosed)
            {
                <button type="button" class="btn-secondary" @onclick="ConfirmReopenAsync">활동 다시 열기</button>
                <button type="button" class="btn-danger" @onclick="ConfirmStartNewAsync">활동 새로 시작</button>
            }
        </div>
        <div style="height:10px"></div>
        <div class="btn-row">
            <a href="/admin/attendance" class="btn-ghost">출석 관리</a>
            <a href="/admin/teams" class="btn-ghost">팀 뽑기</a>
        </div>
    </div>

    @if (teams.Count > 0)
    {
        <div class="card">
            <h2 class="card-title">현재 팀</h2>
            @foreach (var team in teams)
            {
                <div class="card-row" style="padding:6px 0">
                    <span style="font-weight:700">@team.Name</span>
                    <span class="badge badge-orange">@(team.Members.Count)명</span>
                </div>
            }
        </div>
    }
}

<div class="card">
    <h2 class="card-title">관리 메뉴</h2>
    <div class="btn-row">
        <a href="/admin/semesters" class="btn-ghost">학기 관리</a>
        <a href="/admin/settings" class="btn-ghost">설정</a>
        <a href="/admin/audit" class="btn-ghost">감사 로그</a>
        <button type="button" class="btn-ghost" disabled="@resyncing" @onclick="ResyncAsync">@(resyncing ? "갱신 중…" : "시트 갱신")</button>
    </div>
    @if (resyncReport is not null)
    {
        <div class="day-detail" style="margin-top:10px">
            <div class="dd-date">갱신 결과</div>
            <div class="dd-info">활동 @(resyncReport.ImportedActivities)건 · 출석 @(resyncReport.ImportedAttendances)건 · 시트 기록 @(resyncReport.ExportedColumns)건</div>
            @foreach (var w in resyncReport.Warnings.Take(10))
            {
                <div class="dd-info miss">@w</div>
            }
        </div>
    }
</div>
</div>

@if (showOtpZoom && !string.IsNullOrEmpty(today?.OtpCode))
{
    <div class="otp-fs" @onclick="() => showOtpZoom = false">
        <div class="otp-fs-panel" @onclick:stopPropagation="true">
            <div class="otp-fs-head">
                <span class="sec-title">오늘의 OTP</span>
                <button type="button" class="team-fs-close" @onclick="() => showOtpZoom = false" aria-label="닫기">✕</button>
            </div>
            <div class="otp-fs-body">
                @{ var j = 0; }
                @foreach (var ch in today?.OtpCode ?? "")
                {
                    <span @key="@(j++ + "-" + ch)">@ch</span>
                }
            </div>
        </div>
    </div>
}

@if (showCancelConfirm)
{
    <div class="confirm-overlay" @onclick="() => showCancelConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>활동 취소</h3>
            <p>오늘 활동과 아래 기록이 모두 삭제되며 되돌릴 수 없습니다.</p>
            <p style="font-weight:700">출석 @(today?.AttendanceCount)명 · 게스트 @(today?.GuestCount)명 · 팀 @(today?.TeamCount)개</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showCancelConfirm = false">취소</button>
                <button type="button" class="btn-danger" disabled="@(deleteCountdown > 0)" @onclick="CancelActivityAsync">@(deleteCountdown > 0 ? $"{deleteCountdown}초 후 삭제 가능" : "삭제")</button>
            </div>
        </div>
    </div>
}

@if (showCloseConfirm)
{
    <div class="confirm-overlay" @onclick="() => showCloseConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>오늘 활동 종료</h3>
            <p>활동을 마감하면 출석·팀 변경이 불가합니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showCloseConfirm = false">취소</button>
                <button type="button" class="btn-primary" @onclick="CloseActivityAsync">마감</button>
            </div>
        </div>
    </div>
}

@if (showReopenConfirm)
{
    <div class="confirm-overlay" @onclick="() => showReopenConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>활동 다시 열기</h3>
            <p>기록은 유지되고 수정이 가능해집니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showReopenConfirm = false">취소</button>
                <button type="button" class="btn-primary" @onclick="ReopenAsync">다시 열기</button>
            </div>
        </div>
    </div>
}

@if (showStartNewConfirm)
{
    <div class="confirm-overlay" @onclick="() => showStartNewConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>활동 새로 시작</h3>
            <p>마감된 활동 기록은 그대로 남고, 별도 출석을 받는 새 활동이 시작됩니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showStartNewConfirm = false">취소</button>
                <button type="button" class="btn-primary" @onclick="StartNewAsync">새로 시작</button>
            </div>
        </div>
    </div>
}

@code {
    private bool resyncing;

    private SheetSyncReport? resyncReport;

    private async Task ResyncAsync()
    {
        resyncing = true;
        try
        {
            resyncReport = await SheetSync.ResyncAsync();
            Snackbar.Add("시트 갱신 완료", Severity.Success);

            StateHasChanged();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            resyncing = false;
        }
    }

    private AdminTodayDto? today;
    private List<TeamResultDto> teams = [];
    private bool showOtpZoom;
    private bool showCloseConfirm;
    private bool showReopenConfirm;
    private bool showStartNewConfirm;
    private bool showCancelConfirm;
    private int deleteCountdown;
    private int countdownRun;

    private bool IsActive => today is not null
        && today.Status != ActivityStatus.Ready
        && today.Status != ActivityStatus.ActivityClosed;

    private string StatusBadgeClass => today?.Status switch
    {
        ActivityStatus.AttendanceOpen => "badge-green",
        ActivityStatus.ActivityClosed => "badge-red",
        ActivityStatus.TeamCreated => "badge-orange",
        _ => "badge-gray",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            today = await Activities.GetOrCreateTodayAsync();
            teams = await Teams.GetTodayTeamsForAdminAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RunAsync(Func<Task<AdminTodayDto>> action)
    {
        try
        {
            today = await action();
            Snackbar.Add("처리되었습니다.", Severity.Success);
            await LoadAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task GenerateOtpAsync()
    {
        try
        {
            await Activities.GenerateOtpAsync();
            Snackbar.Add("OTP가 갱신되었습니다.", Severity.Success);
            await LoadAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ConfirmCloseActivityAsync() => showCloseConfirm = true;

    private async Task CloseActivityAsync()
    {
        showCloseConfirm = false;
        await RunAsync(Activities.CloseActivityAsync);
    }

    private void ConfirmReopenAsync() => showReopenConfirm = true;

    private async Task ReopenAsync()
    {
        showReopenConfirm = false;
        await RunAsync(Activities.ReopenActivityAsync);
    }

    private void ConfirmStartNewAsync() => showStartNewConfirm = true;

    private async Task StartNewAsync()
    {
        showStartNewConfirm = false;
        await RunAsync(Activities.StartNewActivityAsync);
    }

    private void ConfirmCancelActivityAsync() => _ = RunDeleteCountdownAsync();

    /// <summary>모달이 다시 열릴 때마다 새 카운트다운만 살아남도록 실행 세대로 무효화한다.</summary>
    private async Task RunDeleteCountdownAsync()
    {
        showCancelConfirm = true;
        var run = ++countdownRun;
        for (var remain = 5; remain > 0; remain--)
        {
            deleteCountdown = remain;
            StateHasChanged();
            await Task.Delay(1000);
            if (!showCancelConfirm || run != countdownRun)
            {
                return;
            }
        }
        deleteCountdown = 0;
        StateHasChanged();
    }

    private async Task CancelActivityAsync()
    {
        showCancelConfirm = false;
        try
        {
            await Activities.CancelActivityAsync();
            Snackbar.Add("활동이 취소되었습니다.", Severity.Success);
            await LoadAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
