@page "/admin/settings"
@attribute [Authorize(Roles = "ADMIN")]

@inject SettingClient SettingSvc
@inject SheetAdminClient SheetAdminSvc
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Settings> Logger
@using Microsoft.Extensions.Logging

<PageTitle>설정 · 빅이큐</PageTitle>

<h1 class="page-title"><img class="icon" src="/icons/gear.svg" alt=""> 설정</h1>

<div class="card settings-card" data-load-state="@LoadState">
    <h2 class="card-title">시트 목록 (종류별)</h2>
    <div class="settings-load-region" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
        @if (isLoading)
        {
            <span class="admin-load-status" role="status">시트 목록을 불러오는 중…</span>
        }
        @if (loadError is not null)
        {
            <div role="alert">
                <p>@loadError</p>
                <button type="button" class="btn-primary" @onclick="ReadAsync">다시 불러오기</button>
            </div>
        }
    </div>
    @if (loadError is null)
    {
        @for (var i = 0; i < (hasLoaded ? sheets.Count : 1); i++)
        {
            var sheet = hasLoaded ? sheets[i] : null;
            <div class="btn-row settings-sheet-row" style="align-items:flex-end" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
                @if (sheet is not null)
                {
                    <div class="field settings-sheet-value" style="flex:1" aria-hidden="@(isLoading ? "true" : "false")">
                        <label class="form-label">이름</label>
                        <input class="form-control" @bind="sheet.Name" />
                    </div>
                    <div class="field settings-sheet-value" style="flex:2" aria-hidden="@(isLoading ? "true" : "false")">
                        <label class="form-label">주소 (docs.google.com/…)</label>
                        <input class="form-control" @bind="sheet.SpreadsheetId" />
                    </div>
                    <button type="button" class="btn-secondary settings-sheet-value" aria-hidden="@(isLoading ? "true" : "false")" @onclick="() => SaveSheetAsync(sheet)">저장</button>
                    <button type="button" class="btn-danger settings-sheet-value" aria-hidden="@(isLoading ? "true" : "false")" @onclick="() => DeleteSheetAsync(sheet)">삭제</button>
                }
                @if (isLoading)
                {
                    <div class="btn-row settings-sheet-skeleton" data-retained="@(hasLoaded ? "true" : "false")" aria-hidden="true" style="align-items:flex-end">
                        <div class="field" style="flex:1">
                            <span class="form-label">이름</span>
                            <div class="form-control"><span class="loading-placeholder">&nbsp;</span></div>
                        </div>
                        <div class="field" style="flex:2">
                            <span class="form-label">주소 (docs.google.com/…)</span>
                            <div class="form-control"><span class="loading-placeholder">&nbsp;</span></div>
                        </div>
                        <span class="btn-secondary"><span class="loading-placeholder">&nbsp;</span></span>
                        <span class="btn-danger"><span class="loading-placeholder">&nbsp;</span></span>
                    </div>
                }
            </div>
        }
    }
    <div class="btn-row" style="align-items:flex-end">
        <div class="field" style="flex:1">
            <label class="form-label">새 시트 이름</label>
            <input class="form-control" @bind="newSheetName" placeholder="출석부" />
        </div>
        <div class="field" style="flex:2">
            <label class="form-label">새 시트 주소</label>
            <input class="form-control" @bind="newSheetUrl" placeholder="https://docs.google.com/spreadsheets/d/…" />
        </div>
        <button type="button" class="btn-secondary" @onclick="AddSheetAsync">추가</button>
    </div>

    <h2 class="card-title">구글 시트 연동</h2>
    <div class="field">
        <label class="form-label">서비스 계정 키 (JSON 본문 또는 파일 경로) — 변경할 때만 입력</label>
        <textarea class="form-control" rows="3" @bind="serviceAccountKey"
                  placeholder='{"type": "service_account", …} 또는 C:\path\key.json'></textarea>
    </div>
    <button type="button" class="btn-primary btn-block" @onclick="SaveKeyAsync">키 저장</button>
</div>

@code {
    private bool isLoading = true;
    private bool hasLoaded;
    private bool isRefreshing;
    private string? loadError;
    private int loadGeneration;
    private string LoadState => isLoading ? "loading" : isRefreshing ? "refreshing" : loadError is not null ? "error" : "ready";
    private string serviceAccountKey = "";
    private List<EditableSheet> sheets = [];
    private string newSheetName = "";
    private string newSheetUrl = "";

    private class EditableSheet
    {
        public int Id { get; set; }

        public string Name { get; set; } = "";

        public string SpreadsheetId { get; set; } = "";
    }

    protected override Task OnInitializedAsync()
    {
        serviceAccountKey = ""; // 미리 불러오지 않는다 — 민감 키는 표시하지 않고 변경 시에만 입력
        return ReadAsync();
    }

    private Task ReadAsync() => LoadSheetsAsync(showSkeleton: true);

    private Task LoadSheetsAsync() => LoadSheetsAsync(showSkeleton: false);

    private async Task LoadSheetsAsync(bool showSkeleton)
    {
        var generation = ++loadGeneration;
        isLoading = showSkeleton || !hasLoaded || isLoading;
        isRefreshing = !isLoading;
        loadError = null;
        try
        {
            var definitions = await SheetAdminSvc.GetListAsync()
                ?? throw new InvalidOperationException("시트 목록 응답이 없습니다.");
            var loaded = definitions
                .Select(s => new EditableSheet { Id = s.Id, Name = s.Name, SpreadsheetId = s.SpreadsheetId })
                .ToList();
            if (generation != loadGeneration) return;
            sheets = loaded;
            hasLoaded = true;
        }
        catch (AppException ex)
        {
            if (generation != loadGeneration) return;
            loadError = ex.Message;
            if (!showSkeleton) throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "시트 목록 조회 실패");
            if (generation != loadGeneration) return;
            loadError = "시트 목록을 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
            if (!showSkeleton) throw new AppException(loadError);
        }
        finally
        {
            if (generation == loadGeneration)
            {
                isLoading = false;
                isRefreshing = false;
            }
        }
    }

    private async Task SaveKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(serviceAccountKey))
        {
            Snackbar.Add("저장된 키를 유지합니다 — 변경할 때만 입력하세요.", Severity.Info);
            return;
        }

        await SettingSvc.SaveGoogleKeyAsync(serviceAccountKey.Trim());
        Snackbar.Add("키가 저장되었습니다. 다음 동기화부터 적용됩니다.", Severity.Success);
        serviceAccountKey = "";
    }

    private async Task SaveSheetAsync(EditableSheet sheet)
    {
        try
        {
            await SheetAdminSvc.SaveAsync(sheet.Id, sheet.Name, sheet.SpreadsheetId);
            Snackbar.Add($"시트 '{sheet.Name.Trim()}' 저장 완료", Severity.Success);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AddSheetAsync()
    {
        try
        {
            await SheetAdminSvc.SaveAsync(null, newSheetName, newSheetUrl);
            Snackbar.Add($"시트 '{newSheetName.Trim()}' 추가 완료", Severity.Success);
            newSheetName = "";
            newSheetUrl = "";
            await LoadSheetsAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteSheetAsync(EditableSheet sheet)
    {
        try
        {
            await SheetAdminSvc.DeleteAsync(sheet.Id);
            Snackbar.Add($"시트 '{sheet.Name}' 삭제", Severity.Success);
            sheets.Remove(sheet);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
