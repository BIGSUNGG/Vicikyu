@page "/admin/settings"
@attribute [Authorize(Roles = "ADMIN")]

@inject ActivityArchiveClient Archive
@inject MemberClient MembersSvc
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Settings> Logger
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Forms
@using VolleyballClub.Application.Dtos

<PageTitle>설정 · 빅이큐</PageTitle>

<h1 class="page-title"><img class="icon" src="/icons/gear.svg" alt=""> 설정</h1>

<DatabaseBackupSettings />

<div class="card settings-card">
    <h2 class="card-title">활동 기록 가져오기 · 내보내기 (xlsx)</h2>
    <p class="form-label">학기별 탭 출석부 파일을 업로드하면 기존 기록과 병합합니다(같은 파일을 다시 올려도 중복이 생기지 않습니다).
        매칭되지 않은 부원 행은 아래 '미매핑 부원'에 보관됩니다. 업로드한 파일은 서버에 저장되지 않습니다.</p>
    <div class="btn-row" style="align-items:flex-end">
        <div class="field" style="flex:1">
            <label class="form-label">활동 기록 xlsx (최대 8MB)</label>
            <InputFile OnChange="OnFileSelectedAsync" accept=".xlsx" />
        </div>
        <button type="button" class="btn-primary" disabled="@(importing || selectedFile is null)" @onclick="ImportAsync">
            @(importing ? "가져오는 중…" : "가져오기")
        </button>
        <button type="button" class="btn-secondary" disabled="@exporting" @onclick="ExportAsync">
            @(exporting ? "내보내는 중…" : "전체 기록 내보내기")
        </button>
    </div>
    @if (importReport is not null)
    {
        <div class="day-detail" style="margin-top:10px">
            <div class="dd-date">가져오기 결과</div>
            <div class="dd-info">활동 @(importReport.ImportedActivities)건 추가 · 출석 @(importReport.ImportedAttendances)건 추가 · 예정/없음 표시 @(importReport.DayMarks)건 · 미매핑 부원 @(importReport.UnmappedMembers)명</div>
            @foreach (var w in importReport.Warnings.Take(20))
            {
                <div class="dd-info miss">@w</div>
            }
        </div>
    }
</div>

<div class="card settings-card" data-load-state="@UnmappedLoadState">
    <h2 class="card-title">미매핑 부원</h2>
    <p class="form-label">가져오기에서 계정과 매칭되지 않은 부원 행입니다. 실제 부원과 연동하면 출석 기록이 해당 계정으로 이어지고 목록에서 사라집니다.</p>
    @if (unmappedLoading)
    {
        <span class="admin-load-status" role="status">미매핑 부원을 불러오는 중…</span>
    }
    else if (unmappedError is not null)
    {
        <div role="alert"><p>@unmappedError</p></div>
    }
    else if (unmapped.Count == 0)
    {
        <p class="dd-info">미매핑 부원이 없습니다.</p>
    }
    else
    {
        @foreach (var member in unmapped)
        {
            <div class="btn-row" style="align-items:flex-end">
                <div class="field" style="flex:1">
                    <label class="form-label">@member.Label — 출석 @(member.AttendanceCount)건</label>
                    <select class="form-control" @bind="linkTargets[member.Id]">
                        <option value="">부원 선택…</option>
                        @foreach (var candidate in memberCandidates)
                        {
                            <option value="@candidate.UserId">@candidate.Name (@candidate.StudentNumber)</option>
                        }
                    </select>
                </div>
                <button type="button" class="btn-secondary" disabled="@(string.IsNullOrEmpty(linkTargets.GetValueOrDefault(member.Id)))"
                        @onclick="() => LinkAsync(member.Id)">연동</button>
            </div>
        }
    }
</div>

@code {
    private bool importing;
    private bool exporting;
    private IBrowserFile? selectedFile;
    private ActivityImportReport? importReport;

    private bool unmappedLoading = true;
    private string? unmappedError;
    private List<UnmappedMemberDto> unmapped = [];
    private Dictionary<int, string> linkTargets = [];
    private List<MemberListItemDto> memberCandidates = [];
    private string UnmappedLoadState => unmappedLoading ? "loading" : unmappedError is not null ? "error" : "ready";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            unmapped = await Archive.GetUnmappedAsync();
            memberCandidates = [];
            for (var page = 1; ; page++)
            {
                var result = await MembersSvc.GetPageAsync(new MemberPageRequest(PageSize: 100, Page: page));
                memberCandidates.AddRange(result.Items);
                if (memberCandidates.Count >= result.TotalCount || result.Items.Count == 0) break;
            }
            linkTargets = unmapped.ToDictionary(m => m.Id, _ => "");
        }
        catch (AppException ex)
        {
            unmappedError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "미매핑 부원 조회 실패");
            unmappedError = "미매핑 부원 목록을 불러오지 못했습니다.";
        }
        finally
        {
            unmappedLoading = false;
        }
    }

    private void OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        selectedFile = e.FileCount == 1 ? e.File : null;
        importReport = null;
    }

    private async Task ImportAsync()
    {
        if (selectedFile is null) return;
        importing = true;
        try
        {
            importReport = await Archive.ImportAsync(selectedFile);
            Snackbar.Add("활동 기록 가져오기 완료", Severity.Success);
            await ReloadUnmappedAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "활동 기록 가져오기 실패");
            Snackbar.Add("가져오지 못했습니다. 파일 형식과 크기를 확인해 주세요.", Severity.Error);
        }
        finally
        {
            importing = false;
        }
    }

    private async Task ExportAsync()
    {
        exporting = true;
        try
        {
            await Archive.ExportAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "활동 기록 내보내기 실패");
            Snackbar.Add("내보내지 못했습니다.", Severity.Error);
        }
        finally
        {
            exporting = false;
        }
    }

    private async Task LinkAsync(int unmappedId)
    {
        var userId = linkTargets.GetValueOrDefault(unmappedId);
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await Archive.LinkAsync(unmappedId, userId);
            Snackbar.Add("연동 완료 — 출석 기록을 이관했습니다.", Severity.Success);
            await ReloadUnmappedAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ReloadUnmappedAsync()
    {
        unmapped = await Archive.GetUnmappedAsync();
        linkTargets = unmapped.ToDictionary(m => m.Id, _ => "");
    }
}
