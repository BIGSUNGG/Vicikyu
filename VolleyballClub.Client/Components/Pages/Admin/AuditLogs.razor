@page "/admin/audit"
@attribute [Authorize(Roles = "ADMIN")]

@inject AuditLogClient Audit
@inject Microsoft.Extensions.Logging.ILogger<AuditLogs> Logger
@using Microsoft.Extensions.Logging

<PageTitle>감사 로그 · 빅이큐</PageTitle>

<h1 class="page-title"><img class="icon" src="/icons/scroll.svg" alt=""> 감사 로그</h1>

<div class="card audit-card" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
    <div class="admin-load-region">
    @if (isLoading)
    {
        <span class="admin-load-status" role="status">감사 로그를 불러오는 중…</span>
        <div class="admin-load-skeleton" data-retained="@(hasLoaded ? "true" : "false")" aria-hidden="true">
            @if (hasLoaded && logs.Count == 0)
            {
                <p class="empty"><span class="loading-placeholder">&nbsp;</span></p>
            }
            else
            {
                <div class="card-list split-2">
                    @for (var i = 0; i < (hasLoaded ? logs.Count : 3); i++)
                    {
                        <div class="member-row">
                            <div>
                                <div class="member-name"><span class="loading-placeholder">&nbsp;</span></div>
                                <div class="member-meta"><span class="loading-placeholder">&nbsp;</span></div>
                            </div>
                            <div style="margin-left:auto;text-align:right">
                                <div class="member-meta"><span class="loading-placeholder">&nbsp;</span></div>
                                <div class="member-meta"><span class="loading-placeholder">&nbsp;</span></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (loadError is not null)
    {
        <div role="alert">
            <p>@loadError</p>
            <button type="button" class="btn-primary" @onclick="LoadAsync">다시 불러오기</button>
        </div>
    }
    else if (hasLoaded)
    {
    <div class="admin-load-values" aria-hidden="@(isLoading ? "true" : "false")">
    @if (logs.Count == 0)
    {
        <p class="empty">기록이 없습니다.</p>
    }
    else
    {
        <div class="card-list split-2">
            @foreach (var log in logs)
            {
                <div class="member-row" style="cursor:default">
                    <div>
                        <div class="member-name">@ActionText(log.Action)</div>
                        <div class="member-meta">@log.Details</div>
                    </div>
                    <div style="margin-left:auto;text-align:right">
                        <div class="member-meta">@log.AdminName</div>
                        <div class="member-meta">@Domain.KstClock.ToKstDateString(log.CreatedAt) @Domain.KstClock.ToKstTimeString(log.CreatedAt)</div>
                    </div>
                </div>
            }
        </div>
    }
    </div>
    }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool hasLoaded;
    private string? loadError;
    private int loadGeneration;
    private string LoadState => isLoading ? "loading" : loadError is not null ? "error" : "ready";
    private List<AuditLogDto> logs = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++loadGeneration;
        isLoading = true;
        loadError = null;
        try
        {
            var loaded = await Audit.GetRecentAsync(100)
                ?? throw new InvalidOperationException("감사 로그 응답이 없습니다.");
            if (generation != loadGeneration) return;
            logs = loaded;
            hasLoaded = true;
        }
        catch (AppException ex)
        {
            if (generation == loadGeneration) loadError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "감사 로그 조회 실패");
            if (generation == loadGeneration) loadError = "감사 로그를 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
        }
        finally
        {
            if (generation == loadGeneration) isLoading = false;
        }
    }

    private static string ActionText(AdminAction action) => action switch
    {
        AdminAction.ActivityCreate => "활동 생성",
        AdminAction.ActivityReopen => "활동 다시 열기",
        AdminAction.ActivityClose => "활동 마감",
        AdminAction.AttendanceOpen => "활동 시작",
        AdminAction.AttendanceClose => "출석 마감",
        AdminAction.AttendanceAdd => "직접 출석 추가",
        AdminAction.AttendanceRemove => "출석 취소",
        AdminAction.OtpChange => "OTP 변경",
        AdminAction.GuestAdd => "게스트 추가",
        AdminAction.GuestRemove => "게스트 제거",
        AdminAction.TeamCreate => "팀 편성",
        AdminAction.TeamChange => "팀 변경",
        AdminAction.TeamConfirm => "팀 편성 확정",
        AdminAction.TeamDelete => "팀 편성 취소",
        AdminAction.MemberCreate => "부원 추가",
        AdminAction.MemberUpdate => "부원 수정",
        AdminAction.MemberDisable => "부원 비활성화",
        AdminAction.MemberEnable => "부원 활성화",
        AdminAction.MemberPasswordReset => "부원 비밀번호 초기화",
        AdminAction.FeePeriodCreate => "회비 기간 생성",
        AdminAction.FeePeriodUpdate => "회비 기간 수정",
        AdminAction.FeePeriodDelete => "회비 기간 삭제",
        AdminAction.FeeStatusChange => "회비 상태 변경",
        AdminAction.SemesterCreate => "학기 생성",
        AdminAction.SemesterUpdate => "학기 수정",
        AdminAction.SemesterDelete => "학기 삭제",
        AdminAction.SettingChange => "설정 변경",
        _ => action.ToString(),
    };
}
