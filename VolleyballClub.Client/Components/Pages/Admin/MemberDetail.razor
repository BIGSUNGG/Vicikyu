@page "/admin/members/{UserId}"
@attribute [Authorize(Roles = "ADMIN")]
@implements IDisposable

@inject MemberClient MemberSvc
@inject AdminActivityClient ActivitySvc
@inject SemesterMemberClient SheetRows
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<MemberDetail> Logger
@using Microsoft.Extensions.Logging

<PageTitle>부원 정보 · 빅이큐</PageTitle>

<AdminNav Icon="/icons/users.svg" Title="부원 정보" Sub="@(memberLoading ? "정보를 불러오는 중…" : member is null ? "부원 정보 조회 실패" : $"{member.StudentNumber} · {StatusLabel(member.Status)}")" Active="members" />

<nav class="segment member-detail-tabs" aria-busy="@(memberLoading ? "true" : "false")" data-load-state="@MemberLoadState">
    <a class="seg-btn @(section == Section.Edit ? "active" : "")" aria-disabled="@(memberLoading || member is null)" @onclick="() => OpenSectionAsync(Section.Edit)" href="javascript:void(0)">부원 수정</a>
    <a class="seg-btn @(section == Section.Attendance ? "active" : "")" aria-disabled="@(memberLoading || member is null)" @onclick="() => OpenSectionAsync(Section.Attendance)" href="javascript:void(0)">출석 기록</a>
    <a class="seg-btn @(section == Section.Sheet ? "active" : "")" aria-disabled="@(memberLoading || member is null)" @onclick="() => OpenSectionAsync(Section.Sheet)" href="javascript:void(0)">시트 연결</a>
</nav>

@if (memberLoading)
{
    <span class="admin-load-status" role="status">부원 정보를 불러오는 중…</span>
    <div class="card member-initial" aria-hidden="true">
        <h2 class="card-title"><span class="loading-placeholder">&nbsp;</span></h2>
        @for (var row = 0; row < 6; row++)
        {
            <div class="field"><span class="form-label"><span class="loading-placeholder">&nbsp;</span></span><div class="form-control"><span class="loading-placeholder">&nbsp;</span></div></div>
        }
    </div>
}
else if (memberError is not null)
{
    <div class="card" role="alert"><p>@memberError</p><button type="button" class="btn-primary" @onclick="RetryMemberAsync">다시 불러오기</button></div>
}

@if (section == Section.Edit && member is not null && !memberLoading && memberError is null)
{
    <div class="card member-edit">
        <h2 class="card-title">부원 수정 — @member.Name</h2>
        <EditForm Model="editForm" OnValidSubmit="SaveEditAsync">
            <DataAnnotationsValidator />
            <div class="field">
                <label class="form-label">학번</label>
                <InputText @bind-Value="editForm.StudentNumber" class="form-control" />
            </div>
            <div class="field">
                <label class="form-label">이름</label>
                <InputText @bind-Value="editForm.Name" class="form-control" />
            </div>
            <div class="field">
                <label class="form-label">학과</label>
                <InputText @bind-Value="editForm.Department" class="form-control" />
            </div>
            <div class="field">
                <label class="form-label">색상</label>
                <div class="color-swatches">
                    @foreach (var color in Domain.MemberColors.Palette)
                    {
                        <button type="button" class="color-swatch @(editForm.Color == color ? "selected" : "")"
                                style="--mc:@color" aria-label="색상 @color" @onclick="() => editForm.Color = color"></button>
                    }
                </div>
            </div>
            <div class="field">
                <label class="form-label">역할</label>
                <select class="form-control" value="@editForm.Role" @onchange='e => editForm.Role = e.Value?.ToString() ?? "MEMBER"'>
                    <option value="MEMBER">부원</option>
                    <option value="ADMIN">관리자</option>
                </select>
            </div>
            <div class="field">
                <label class="form-label">새 비밀번호 (선택)</label>
                <InputText type="password" @bind-Value="editForm.NewPassword" class="form-control"
                           placeholder="비워 두면 변경하지 않음" autocomplete="new-password" />
            </div>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick='() => Nav.NavigateTo("/admin/members")'>목록으로</button>
                <button type="submit" class="btn-primary">저장</button>
            </div>
        </EditForm>

        <div style="height:10px"></div>
        <label class="form-label">활동 상태</label>
        <div class="filter-group">
            @foreach (var (status, label, css) in new[]
                     {
                         (MemberStatus.Active, "활동 중 전환", "btn-secondary"),
                         (MemberStatus.Withdrawn, "탈퇴 처리", "btn-secondary"),
                         (MemberStatus.Expelled, "퇴출 처리", "btn-danger"),
                     })
            {
                <button type="button" class="@css" disabled="@(member.Status == status)" @onclick="() => confirmStatus = (member.Name, status)">@label</button>
            }
        </div>
        <p class="member-meta">비활동 상태의 부원은 로그인·출석·팀 편성에서 제외됩니다. 출석 기록은 보존됩니다.</p>
    </div>
}

@if (section == Section.Attendance && member is not null && !memberLoading)
{
    <div class="card member-attendance" aria-busy="@(attendanceLoading || attendanceBusy ? "true" : "false")" data-load-state="@AttendanceLoadState">
        <h2 class="card-title">출석 기록 — @member.Name</h2>
        @if (attendanceWriteError is not null)
        {
            <p class="attendance-write-error" role="alert">@attendanceWriteError</p>
        }
        @if (attendanceBusy)
        {
            <span role="status">출석 변경 중…</span>
        }
        <div class="admin-load-region">
        @if (attendanceLoading)
        {
            <span class="admin-load-status" role="status">출석 기록을 불러오는 중…</span>
            <div class="admin-load-skeleton" data-retained="@(attendance is not null ? "true" : "false")" aria-hidden="true">
                <p class="member-meta"><span class="loading-placeholder" style="min-width:12em">&nbsp;</span></p>
                @for (var row = 0; row < (attendance is null ? 3 : Math.Max(1, attendance.Items.Count)); row++)
                {
                    <div class="member-row"><div><div class="member-name"><span class="loading-placeholder">&nbsp;</span></div><div class="member-meta"><span class="loading-placeholder">&nbsp;</span></div></div></div>
                }
            </div>
        }
        @if (attendanceError is not null)
        {
            <div role="alert"><p>@attendanceError</p><button type="button" class="btn-primary" @onclick="ReadAttendanceAsync">다시 불러오기</button></div>
        }
        else if (attendance is not null)
        {
        <div class="admin-load-values" aria-hidden="@(attendanceLoading ? "true" : "false")">
        <p class="member-meta">
            이번 달 @(attendance.MonthCount)회 · 이번 학기 @(attendance.SemesterCount)회 · 총 @(attendance.TotalCount)회
        </p>

        <p class="member-meta">모든 학기 활동입니다. 예정·없음은 출석을 수정할 수 없습니다.</p>
        <div class="card-list">
            @if (attendance.Items.Count == 0)
            {
                <p class="member-meta">등록된 활동이 없습니다.</p>
            }
            @foreach (var record in attendance.Items)
            {
                <div class="member-row" @key="record.Key" data-activity-key="@record.Key">
                    <input type="checkbox" role="switch" checked="@record.IsAttended" aria-checked="@(record.IsAttended ? "true" : "false")"
                           aria-label="@($"{record.Date:yyyy.MM.dd} {member.Name} 출석 ({record.Label ?? "정기 활동"})")"
                           disabled="@(attendanceBusy || attendanceLoading || !record.CanEditAttendance)"
                           @onclick="() => ToggleAttendanceAsync(record)" @onclick:preventDefault />
                    <div class="attendance-description">
                        <div class="member-name">@record.Date.ToString("yyyy.MM.dd") · @record.StateText</div>
                        <div class="member-meta">@(record.Label ?? "정기 활동") · @(record.IsAttended ? "출석" : "미출석")@(record.HasTeam ? " · 팀 편성 있음" : "")</div>
                    </div>
                </div>
            }
        </div>
        </div>
        }
        </div>
    </div>
}

@if (section == Section.Sheet && member is not null && !memberLoading)
{
    <div class="card member-sheet" data-load-state="@(sheetLoading ? "loading" : sheetError is not null ? "error" : "ready")">
        <h2 class="card-title">시트 연결 — @member.Name</h2>
        <p class="member-meta">학기별 부원 행을 이 계정에 연결합니다. 연결하면 그 행의 출석이 이 부원의 통계에 합산되고, 행은 영구 보존됩니다.</p>
        @if (sheetLoading)
        {
            <span class="admin-load-status" role="status">학기별 행을 불러오는 중…</span>
        }
        else if (sheetError is not null)
        {
            <div role="alert"><p>@sheetError</p><button type="button" class="btn-primary" @onclick="LoadSheetRowsAsync">다시 불러오기</button></div>
        }
        else if (sheetRows is null || sheetRows.Semesters.Count == 0)
        {
            <p class="member-meta">등록된 학기·학기별 부원 행이 없습니다 — 설정에서 시트를 먼저 가져오세요.</p>
        }
        else
        {
            @foreach (var semester in sheetRows.Semesters)
            {
                <div class="btn-row settings-sheet-row" style="align-items:flex-end">
                    <div class="field" style="flex:1">
                        @if (semester.MappedRowId is { } rowId)
                        {
                            <label class="form-label">@semester.SemesterName — 연결됨: @(semester.MappedRowLabel ?? rowId.ToString()) · 출석 @(semester.AttendanceCount)건</label>
                        }
                        else if (semester.Candidates.Count > 0)
                        {
                            <label class="form-label">@semester.SemesterName — 미연결 행 선택</label>
                            <select class="form-control" value="@sheetPicks.GetValueOrDefault(semester.SemesterId)"
                                    @onchange="e => sheetPicks[semester.SemesterId] = int.TryParse(e.Value?.ToString(), out var picked) ? picked : 0">
                                <option value="0">행 선택…</option>
                                @foreach (var candidate in semester.Candidates)
                                {
                                    <option value="@candidate.Id">@candidate.Label · 출석 @(candidate.AttendanceCount)건</option>
                                }
                            </select>
                        }
                        else
                        {
                            <label class="form-label">@semester.SemesterName</label>
                            <p class="member-meta">연결할 수 있는 미매핑 행이 없습니다.</p>
                        }
                    </div>
                    @if (semester.MappedRowId is { } mappedId)
                    {
                        <button type="button" class="btn-secondary" disabled="@sheetBusy" @onclick="() => UnmapRowAsync(mappedId)">연결 해제</button>
                    }
                    else if (semester.Candidates.Count > 0)
                    {
                        <button type="button" class="btn-secondary" disabled="@(sheetBusy || sheetPicks.GetValueOrDefault(semester.SemesterId) == 0)"
                                @onclick="() => MapRowAsync(semester.SemesterId)">연결</button>
                    }
                </div>
            }
            <p class="member-meta">★ 같은 학기에는 한 계정이 한 행만 연결할 수 있습니다. 새 행은 설정>시트 설정에서 추가하세요.</p>
        }
    </div>
}

@if (confirmStatus is not null)
{
    <div class="confirm-overlay" @onclick="() => confirmStatus = null">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>상태 변경</h3>
            <p>@confirmStatus.Value.Name 님을 <b>@StatusLabel(confirmStatus.Value.Status)</b> 상태로 변경하시겠습니까?</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => confirmStatus = null">취소</button>
                <button type="button" class="btn-primary" @onclick="ChangeStatusAsync">확인</button>
            </div>
        </div>
    </div>
}

@if (confirmRemove is not null)
{
    <div class="confirm-overlay attendance-confirm" @onkeydown="AttendanceDialogKeyDown">
        <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="member-attendance-confirm-heading">
            <MudFocusTrap>
                <h3 id="member-attendance-confirm-heading">출석 취소</h3>
                <p>@confirmRemove.Date.ToString("yyyy.MM.dd") · @member?.Name · @(confirmRemove.Label ?? "정기 활동") 출석을 취소하시겠습니까? 이 활동의 팀에서도 제외됩니다.</p>
                <div class="btn-row">
                    <button type="button" class="btn-ghost" disabled="@attendanceBusy" @onclick="() => confirmRemove = null">취소</button>
                    <button type="button" class="btn-danger" disabled="@attendanceBusy" @onclick="ConfirmRemoveAsync">출석 취소 확인</button>
                </div>
            </MudFocusTrap>
        </div>
    </div>
}

@code {
    [Parameter]
    public string UserId { get; set; } = "";

    private enum Section
    {
        Edit,
        Attendance,
        Sheet,
    }

    private int routeEpoch;
    private int memberGeneration;
    private int attendanceGeneration;
    private bool memberLoading = true;
    private bool attendanceLoading;
    private string? memberError;
    private string? attendanceError;
    private string MemberLoadState => memberLoading ? "loading" : memberError is not null ? "error" : "ready";
    private string AttendanceLoadState => attendanceBusy ? "saving" : attendanceLoading ? "loading" : attendanceError is not null ? "error" : "ready";
    private Section section = Section.Edit;
    private MemberListDto? member;
    private MemberEditForm editForm = new();
    private MemberActivityListDto? attendance;
    private bool attendanceBusy;
    private string? attendanceWriteError;
    private bool sheetLoading;
    private string? sheetError;
    private MemberSheetRowsDto? sheetRows;
    private bool sheetBusy;
    private Dictionary<int?, int> sheetPicks = [];
    private (string Name, MemberStatus Status)? confirmStatus;
    private MemberActivityRowDto? confirmRemove;

    protected override async Task OnParametersSetAsync()
    {
        var epoch = ++routeEpoch;
        attendanceGeneration++;
        member = null;
        attendance = null;
        attendanceLoading = false;
        attendanceError = null;
        section = Section.Edit;
        confirmStatus = null;
        confirmRemove = null;
        attendanceBusy = false;
        attendanceWriteError = null;
        sheetRows = null;
        sheetError = null;
        sheetLoading = false;
        sheetPicks = [];
        await LoadMemberAsync(epoch, UserId);
    }

    private Task RetryMemberAsync() => LoadMemberAsync(routeEpoch, UserId);

    private async Task LoadMemberAsync(int epoch, string requestedUserId)
    {
        var generation = ++memberGeneration;
        memberLoading = true;
        memberError = null;
        try
        {
            var loaded = await MemberSvc.GetAsync(requestedUserId)
                ?? throw new InvalidOperationException("부원 정보 응답이 없습니다.");
            var loadedForm = new MemberEditForm
            {
                StudentNumber = loaded.StudentNumber,
                Name = loaded.Name,
                Department = loaded.Department,
                Role = loaded.Role,
                Color = loaded.Color ?? Domain.MemberColors.Palette[0],
            };
            if (epoch != routeEpoch || generation != memberGeneration) return;
            member = loaded;
            editForm = loadedForm;
        }
        catch (NotFoundException)
        {
            if (epoch != routeEpoch || generation != memberGeneration) return;
            memberError = "부원을 찾을 수 없습니다.";
            Snackbar.Add(memberError, Severity.Error);
            Nav.NavigateTo("/admin/members");
        }
        catch (AppException ex)
        {
            if (epoch == routeEpoch && generation == memberGeneration) memberError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "부원 정보 조회 실패");
            if (epoch == routeEpoch && generation == memberGeneration) memberError = "부원 정보를 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
        }
        finally
        {
            if (epoch == routeEpoch && generation == memberGeneration) memberLoading = false;
        }
    }

    private async Task OpenSectionAsync(Section target)
    {
        if (memberLoading || member is null || memberError is not null || attendanceBusy) return;
        section = target;
        if (target == Section.Attendance) await ReadAttendanceAsync();
        if (target == Section.Sheet && sheetRows is null) await LoadSheetRowsAsync();
    }

    private async Task LoadSheetRowsAsync()
    {
        var epoch = routeEpoch;
        var requestedUserId = UserId;
        sheetLoading = true;
        sheetError = null;
        try
        {
            var loaded = await SheetRows.GetForMemberAsync(requestedUserId);
            if (epoch != routeEpoch) return;
            sheetRows = loaded;
            sheetPicks = loaded.Semesters.ToDictionary(s => s.SemesterId, _ => 0);
        }
        catch (AppException ex)
        {
            if (epoch != routeEpoch) return;
            sheetError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "시트 연결 정보 조회 실패");
            if (epoch != routeEpoch) return;
            sheetError = "시트 연결 정보를 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
        }
        finally
        {
            if (epoch == routeEpoch) sheetLoading = false;
        }
    }

    private async Task MapRowAsync(int? semesterId)
    {
        var rowId = sheetPicks.GetValueOrDefault(semesterId);
        if (rowId == 0 || sheetBusy) return;
        sheetBusy = true;
        try
        {
            await SheetRows.SetMappingAsync(rowId, UserId);
            Snackbar.Add("연결 완료 — 출석 기록이 이 부원 통계에 합산됩니다.", Severity.Success);
            await LoadSheetRowsAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            sheetBusy = false;
        }
    }

    private async Task UnmapRowAsync(int rowId)
    {
        if (sheetBusy) return;
        sheetBusy = true;
        try
        {
            await SheetRows.SetMappingAsync(rowId, null);
            Snackbar.Add("연결을 해제했습니다. 행과 출석 기록은 유지됩니다.", Severity.Success);
            await LoadSheetRowsAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            sheetBusy = false;
        }
    }

    private Task ReadAttendanceAsync() => LoadAttendanceAsync(showSkeleton: true);

    private Task LoadAttendanceAsync() => LoadAttendanceAsync(showSkeleton: false);

    private async Task LoadAttendanceAsync(bool showSkeleton)
    {
        var epoch = routeEpoch;
        var requestedUserId = UserId;
        var generation = ++attendanceGeneration;
        attendanceLoading = showSkeleton || attendance is null || attendanceLoading;
        attendanceError = null;
        try
        {
            var loaded = await ActivitySvc.GetMemberActivitiesAsync(requestedUserId)
                ?? throw new InvalidOperationException("부원 출석 기록 응답이 없습니다.");
            if (epoch != routeEpoch || generation != attendanceGeneration) return;
            attendance = loaded;
        }
        catch (AppException ex)
        {
            if (epoch != routeEpoch || generation != attendanceGeneration) return;
            attendanceError = ex.Message;
            if (!showSkeleton) Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "부원 출석 기록 조회 실패");
            if (epoch != routeEpoch || generation != attendanceGeneration) return;
            attendanceError = "출석 기록을 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
            if (!showSkeleton) Snackbar.Add(attendanceError, Severity.Error);
        }
        finally
        {
            if (epoch == routeEpoch && generation == attendanceGeneration) attendanceLoading = false;
        }
    }

    public void Dispose()
    {
        routeEpoch++;
        memberGeneration++;
        attendanceGeneration++;
    }

    private void AttendanceDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !attendanceBusy) confirmRemove = null;
    }

    private Task ConfirmRemoveAsync() => confirmRemove is { } record
        ? SetAttendanceAsync(record, true) : Task.CompletedTask;

    private Task ToggleAttendanceAsync(MemberActivityRowDto record)
    {
        if (attendanceBusy || attendanceLoading || !record.CanEditAttendance) return Task.CompletedTask;
        if (record.IsAttended && record.HasTeam)
        {
            confirmRemove = record;
            return Task.CompletedTask;
        }
        return SetAttendanceAsync(record, false);
    }

    private async Task SetAttendanceAsync(MemberActivityRowDto record, bool confirmed)
    {
        if (attendanceBusy || attendanceLoading || !record.CanEditAttendance) return;
        var epoch = routeEpoch;
        var requestedUserId = UserId;
        attendanceBusy = true;
        attendanceWriteError = null;
        try
        {
            await ActivitySvc.SetAttendanceAsync(record.Key, requestedUserId, new(!record.IsAttended, confirmed));
            if (epoch != routeEpoch) return;
            Snackbar.Add(record.IsAttended ? "출석 취소 완료" : "출석 추가 완료", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "부원 출석 변경 실패");
            if (epoch != routeEpoch) return;
            attendanceWriteError = ex is AppException ? ex.Message : "출석을 변경하지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
        }
        finally
        {
            if (epoch == routeEpoch)
            {
                confirmRemove = null;
                await LoadAttendanceAsync();
                if (epoch == routeEpoch) attendanceBusy = false;
            }
        }
    }

    private async Task RefreshMemberAfterWriteAsync(int epoch, string requestedUserId)
    {
        if (epoch != routeEpoch) return;
        var generation = ++memberGeneration;
        try
        {
            var loaded = await MemberSvc.GetAsync(requestedUserId)
                ?? throw new InvalidOperationException("부원 정보 응답이 없습니다.");
            if (epoch == routeEpoch && generation == memberGeneration) member = loaded;
        }
        catch (AppException)
        {
            if (epoch == routeEpoch && generation == memberGeneration) throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "저장 후 부원 정보 조회 실패");
            if (epoch == routeEpoch && generation == memberGeneration)
                throw new AppException("저장 후 정보를 불러오지 못했습니다. 다시 확인해 주세요.");
        }
    }

    private async Task SaveEditAsync()
    {
        var epoch = routeEpoch;
        var requestedUserId = UserId;
        try
        {
            await MemberSvc.UpdateAsync(UserId, new MemberUpdateRequest(
                editForm.Name.Trim(),
                editForm.Department.Trim(),
                editForm.StudentNumber.Trim(),
                editForm.Role,
                Color: editForm.Color,
                NewPassword: string.IsNullOrWhiteSpace(editForm.NewPassword) ? null : editForm.NewPassword));
            Snackbar.Add("수정 완료", Severity.Success);
            await RefreshMemberAfterWriteAsync(epoch, requestedUserId);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (confirmStatus is null)
        {
            return;
        }

        var epoch = routeEpoch;
        var requestedUserId = UserId;
        var (_, status) = confirmStatus.Value;
        confirmStatus = null;
        try
        {
            await MemberSvc.UpdateAsync(UserId, new MemberUpdateRequest(
                member?.Name ?? "",
                member?.Department ?? "",
                Status: status));
            Snackbar.Add($"상태 변경 완료 — {StatusLabel(status)}", Severity.Success);
            await RefreshMemberAfterWriteAsync(epoch, requestedUserId);
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string StatusLabel(MemberStatus? status) => status switch
    {
        MemberStatus.Withdrawn => "탈퇴",
        MemberStatus.Expelled => "퇴출",
        _ => "활동",
    };

    private class MemberEditForm
    {
        [Required(ErrorMessage = "학번을 입력하세요.")]
        public string StudentNumber { get; set; } = "";

        [Required(ErrorMessage = "이름을 입력하세요.")]
        public string Name { get; set; } = "";

        public string Department { get; set; } = "";

        public string Role { get; set; } = "MEMBER";

        public string Color { get; set; } = "";

        // 선택 필드 — MinLength는 빈 문자열을 거부하므로 길이 검증은 서버(MemberService)에 맡긴다
        public string NewPassword { get; set; } = "";
    }
}
