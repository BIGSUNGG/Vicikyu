@page "/admin/fees"
@attribute [Authorize(Roles = "ADMIN")]

@inject FeeClient FeeSvc
@inject ISnackbar Snackbar

<PageTitle>회비 관리 · 빅이큐</PageTitle>

<AdminNav Icon="/icons/money.svg" Title="회비 관리" Sub="@($"납부 {paidCount} / {statuses.Count}명")" Active="fees" />

<div class="card">
    <h2 class="card-title">회비 기간</h2>
    <div class="filter-group">
        @foreach (var period in periods)
        {
            <button type="button" class="filter-btn @(selectedPeriodId == period.Id ? "active" : "")"
                    @onclick="() => SelectPeriodAsync(period.Id)">@period.Name</button>
        }
    </div>

    <button type="button" class="btn-secondary btn-block" @onclick="ToggleCreatePeriod">
        @(showCreatePeriod ? "취소" : "+ 기간 추가")
    </button>

    @if (showCreatePeriod)
    {
        <EditForm Model="periodForm" OnValidSubmit="CreatePeriodAsync" class="reveal" style="margin-top:14px">
            <DataAnnotationsValidator />
            <div class="field">
                <label class="form-label">기간 이름 (예: 2026년 2학기)</label>
                <InputText @bind-Value="periodForm.Name" class="form-control" />
            </div>
            <div class="btn-row">
                <div class="field">
                    <label class="form-label">시작일</label>
                    <InputDate @bind-Value="periodForm.StartDate" class="form-control" />
                </div>
                <div class="field">
                    <label class="form-label">종료일</label>
                    <InputDate @bind-Value="periodForm.EndDate" class="form-control" />
                </div>
            </div>
            <div class="field">
                <label class="form-label">회비 금액(원)</label>
                <InputNumber @bind-Value="periodForm.FeeAmount" class="form-control" />
            </div>
            <button type="submit" class="btn-primary btn-block">추가</button>
        </EditForm>
    }
</div>

@if (selectedPeriod is not null)
{
    <div class="card">
        <div class="card-row">
            <h2 class="card-title" style="margin:0">@selectedPeriod.Name — @(selectedPeriod.FeeAmount.ToString("N0"))원</h2>
            <span class="badge badge-blue">납부 @paidCount / @(statuses.Count)명</span>
        </div>

        <button type="button" class="btn-secondary btn-block" style="margin-top:10px" @onclick="ToggleEditPeriod">
            @(showEditPeriod ? "수정 취소" : "기간 정보 수정")
        </button>
        @if (showEditPeriod)
        {
            <EditForm Model="editPeriodForm" OnValidSubmit="UpdatePeriodAsync" class="reveal" style="margin-top:14px">
                <DataAnnotationsValidator />
                <div class="field">
                    <label class="form-label">기간 이름 (예: 2026년 2학기)</label>
                    <InputText @bind-Value="editPeriodForm.Name" class="form-control" />
                </div>
                <div class="btn-row">
                    <div class="field">
                        <label class="form-label">시작일</label>
                        <InputDate @bind-Value="editPeriodForm.StartDate" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="form-label">종료일</label>
                        <InputDate @bind-Value="editPeriodForm.EndDate" class="form-control" />
                    </div>
                </div>
                <div class="field">
                    <label class="form-label">회비 금액(원)</label>
                    <InputNumber @bind-Value="editPeriodForm.FeeAmount" class="form-control" />
                </div>
                <div class="btn-row">
                    <button type="button" class="btn-ghost" @onclick="() => showEditPeriod = false">취소</button>
                    <button type="submit" class="btn-primary btn-block">저장</button>
                </div>
            </EditForm>
        }

        <div style="height:8px"></div>
        <button type="button" class="btn-danger btn-block" @onclick="() => showDeleteConfirm = true">기간 삭제</button>
        <div style="height:12px"></div>

        <div class="toolbar-row">
            <div class="filter-group">
                @foreach (var (value, label) in new[] { (FeeFilter.All, "전체"), (FeeFilter.Paid, "납부"), (FeeFilter.Unpaid, "미납") })
                {
                    <button type="button" class="filter-btn @(filter == value ? "active" : "")" @onclick="() => ChangeFilterAsync(value)">@label</button>
                }
            </div>
            <div class="field">
                <input class="form-control" type="search" placeholder="이름 / 학번 검색" @bind="search" />
            </div>
        </div>

        <div class="card-list split-2">
            @foreach (var status in visibleStatuses)
            {
                <label class="member-row" @key="status.UserId">
                    @* 네이티브 토글을 막고 상태로만 제어 — 갱신 실패 시 뒤집힌 채 남는 것을 방지 *@
                    <input type="checkbox" checked="@status.IsPaid"
                           @onclick="() => SetPaidAsync(status, !status.IsPaid)" @onclick:preventDefault />
                    <div>
                        <div class="member-name">@status.Name</div>
                        <div class="member-meta">@status.StudentNumber · @status.Department</div>
                    </div>
                    @if (status.IsPaid)
                    {
                        <span class="member-time"><img class="icon" src="/icons/check.svg" alt=""> 납부</span>
                    }
                    else
                    {
                        <span class="badge badge-red">미납</span>
                    }
                </label>
            }
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="confirm-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>기간 삭제</h3>
            <p><b>@selectedPeriod?.Name</b> 기간을 삭제합니다. 되돌릴 수 없습니다.</p>
            <p style="font-size:0.85rem">납부 처리된 부원이 있는 기간은 삭제할 수 없습니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => showDeleteConfirm = false">취소</button>
                <button type="button" class="btn-danger" @onclick="DeletePeriodAsync">삭제</button>
            </div>
        </div>
    </div>
}

@code {
    private List<FeePeriodDto> periods = [];
    private int? selectedPeriodId;
    private FeePeriodDto? selectedPeriod;
    private List<FeeStatusDto> statuses = [];
    private FeeFilter filter = FeeFilter.All;
    private string search = "";
    private bool showCreatePeriod;
    private bool showEditPeriod;
    private bool showDeleteConfirm;
    private PeriodForm periodForm = new() { StartDate = DateOnly.FromDateTime(Domain.KstClock.Today(TimeProvider.System).ToDateTime(TimeOnly.MinValue)), EndDate = DateOnly.FromDateTime(Domain.KstClock.Today(TimeProvider.System).ToDateTime(TimeOnly.MinValue).AddMonths(4)) };
    private PeriodForm editPeriodForm = new();

    private int paidCount => statuses.Count(s => s.IsPaid);

    private List<FeeStatusDto> visibleStatuses
    {
        get
        {
            var term = search.Trim();
            var list = statuses;
            if (filter == FeeFilter.Paid)
            {
                list = list.Where(s => s.IsPaid).ToList();
            }
            else if (filter == FeeFilter.Unpaid)
            {
                list = list.Where(s => !s.IsPaid).ToList();
            }

            if (!string.IsNullOrEmpty(term))
            {
                list = list.Where(s => s.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase)
                    || s.StudentNumber.Contains(term, StringComparison.CurrentCultureIgnoreCase)).ToList();
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            periods = await FeeSvc.GetPeriodsAsync();
            if (selectedPeriodId is null)
            {
                var current = await FeeSvc.GetCurrentPeriodAsync();
                selectedPeriodId = current?.Id ?? periods.FirstOrDefault()?.Id;
            }

            selectedPeriod = periods.FirstOrDefault(p => p.Id == selectedPeriodId);
            if (selectedPeriodId is { } id)
            {
                statuses = await FeeSvc.GetPeriodStatusesAsync(id);
            }
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SelectPeriodAsync(int periodId)
    {
        selectedPeriodId = periodId;
        showEditPeriod = false;
        await LoadAsync();
    }

    private void ToggleCreatePeriod()
    {
        showCreatePeriod = !showCreatePeriod;
        showEditPeriod = false;
    }

    private void ToggleEditPeriod()
    {
        showEditPeriod = !showEditPeriod;
        showCreatePeriod = false;
        if (showEditPeriod && selectedPeriod is not null)
        {
            editPeriodForm = new PeriodForm
            {
                Name = selectedPeriod.Name,
                StartDate = selectedPeriod.StartDate,
                EndDate = selectedPeriod.EndDate,
                FeeAmount = selectedPeriod.FeeAmount,
            };
        }
    }

    private async Task ChangeFilterAsync(FeeFilter value)
    {
        filter = value;
        await Task.CompletedTask;
    }

    private async Task SetPaidAsync(FeeStatusDto status, bool isPaid)
    {
        try
        {
            await FeeSvc.SetPaidAsync(status.PeriodId, status.UserId, isPaid);
            Snackbar.Add($"{status.Name} {(isPaid ? "납부 완료" : "미납 처리")}", Severity.Success);
            // 진입 시 정렬 순서를 유지 — 토글한 항목만 제자리 갱신한다.
            statuses = [.. statuses.Select(s => s.UserId == status.UserId ? s with { IsPaid = isPaid } : s)];
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
    }

    private async Task CreatePeriodAsync()
    {
        try
        {
            var created = await FeeSvc.CreatePeriodAsync(new FeePeriodCreateRequest(
                periodForm.Name.Trim(), periodForm.StartDate, periodForm.EndDate, periodForm.FeeAmount));
            Snackbar.Add($"{created.Name} 추가", Severity.Success);
            selectedPeriodId = created.Id;
            showCreatePeriod = false;
            await LoadAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UpdatePeriodAsync()
    {
        if (selectedPeriod is null)
        {
            return;
        }

        try
        {
            var updated = await FeeSvc.UpdatePeriodAsync(selectedPeriod.Id, new FeePeriodUpdateRequest(
                editPeriodForm.Name.Trim(), editPeriodForm.StartDate, editPeriodForm.EndDate, editPeriodForm.FeeAmount));
            Snackbar.Add($"{updated.Name} 수정 완료", Severity.Success);
            showEditPeriod = false;
            await LoadAsync();
        }
        catch (AppException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeletePeriodAsync()
    {
        if (selectedPeriod is null)
        {
            return;
        }

        try
        {
            var name = selectedPeriod.Name;
            await FeeSvc.DeletePeriodAsync(selectedPeriod.Id);
            Snackbar.Add($"{name} 삭제", Severity.Success);
            showDeleteConfirm = false;
            showEditPeriod = false;
            selectedPeriodId = null;
            await LoadAsync();
        }
        catch (AppException ex)
        {
            // 차단(납부 기록 존재) 안내가 모달에 가려지지 않도록 닫고 스낵바로 표시한다
            showDeleteConfirm = false;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private class PeriodForm
    {
        [Required(ErrorMessage = "기간 이름을 입력하세요.")]
        public string Name { get; set; } = "";

        [Required]
        public DateOnly StartDate { get; set; }

        [Required]
        public DateOnly EndDate { get; set; }

        [Range(0, 10_000_000)]
        public int FeeAmount { get; set; } = 30_000;
    }
}
