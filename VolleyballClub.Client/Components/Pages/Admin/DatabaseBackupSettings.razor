@inject DatabaseBackupClient BackupSvc
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<DatabaseBackupSettings> Logger
@using Microsoft.Extensions.Logging

<section class="card settings-card" data-testid="database-backup" aria-labelledby="database-backup-title" aria-busy="@(busy ? "true" : "false")">
    <h2 class="card-title" id="database-backup-title">DB 백업·복원</h2>
    <section class="db-group" aria-labelledby="db-export-title">
        <h3 class="card-title" id="db-export-title">백업 — 내보내기</h3>
        <p class="member-meta">백업에는 모든 계정의 비밀번호 해시 등 민감정보가 포함될 수 있습니다. 암호화되지 않은 파일이므로 안전하게 보관하세요.</p>
        @if (!busy)
        {
            <a class="btn-secondary" href="/api/admin/database/export" download data-testid="database-export">DB 내보내기 (.db)</a>
        }
    </section>
    <section class="db-group" aria-labelledby="db-schedule-title">
        <h3 class="card-title" id="db-schedule-title">자동 백업</h3>
        <p class="member-meta">서버가 실행 중일 때 매일 오후 12시(서버 시간) 서버 DB 폴더의 database-backups에 자동 백업을 남깁니다. 보관 기간이 지나면 오래된 자동 백업부터 삭제됩니다.</p>
        <div class="btn-row" style="align-items:flex-end">
            <div class="field" style="flex:1;max-width:220px">
                <label class="form-label" for="backup-retention-days">백업 보관 기간(일)</label>
                <input id="backup-retention-days" class="form-control" type="number" min="1" max="3650" inputmode="numeric"
                       data-testid="backup-retention-days" value="@retentionInput" @oninput="OnRetentionInput" />
            </div>
            <button type="button" class="btn-primary" data-testid="backup-retention-save"
                    disabled="@(savingRetention || !retentionLoaded || retentionError is not null)" @onclick="SaveRetentionAsync">
                @(savingRetention ? "저장 중…" : "보관 기간 저장")
            </button>
        </div>
        @if (retentionStatus is not null) { <p class="member-meta" role="status" data-testid="backup-retention-status">@retentionStatus</p> }
        @if (retentionError is not null) { <p class="text-danger" role="alert" data-testid="backup-retention-error">@retentionError</p> }
    </section>
    <section class="db-group" aria-labelledby="db-import-title">
        <h3 class="card-title" id="db-import-title">복원 — 가져오기</h3>
        <p class="member-meta">가져오기는 계정·활동·설정 전체를 교체합니다. 현재 앱과 동일한 DB 스키마만 지원하며 최대 64MB입니다. 서버 DB 폴더의 database-backups에 교체 전 자동 백업을 보관합니다.</p>
        <p class="member-meta">복원 중에는 잠시 이용이 중단되며, 완료 후 복원 파일의 계정으로 다시 로그인해야 합니다.</p>
        <fieldset disabled="@busy" style="border:0;padding:0;min-width:0">
            <div class="field">
                <label class="form-label" for="database-import-file">가져올 DB 파일</label>
                <InputFile id="database-import-file" data-testid="database-import-file" accept=".db" OnChange="SelectFile" />
            </div>
            @if (file is not null && !confirming)
            {
                <p class="member-meta">선택한 파일: @file.Name</p>
                <button type="button" class="btn-danger" data-testid="database-import-review" @onclick="Review">전체 복원 확인</button>
            }
            @if (confirming)
            {
                <div role="group" aria-labelledby="database-confirm-title" data-testid="database-confirmation">
                    <h3 class="card-title" id="database-confirm-title">현재 DB 전체를 교체할까요?</h3>
                    <p class="member-meta">@file?.Name 파일로 현재 데이터가 교체됩니다. 복원 파일의 관리자 로그인 정보를 알고 있는지 확인하세요.</p>
                    <label class="member-meta"><input type="checkbox" data-testid="database-import-acknowledge" @bind="acknowledged" /> 전체 교체와 재로그인을 확인했습니다.</label>
                    <div class="btn-row">
                        <button type="button" class="btn-danger" data-testid="database-import-confirm" disabled="@(!acknowledged || busy)" @onclick="RestoreAsync">전체 교체 실행</button>
                        <button type="button" class="btn-secondary" data-testid="database-import-cancel" @onclick="Cancel">취소</button>
                    </div>
                </div>
            }
        </fieldset>
        @if (busy) { <p class="member-meta" role="status" data-testid="database-status">DB 검증·자동 백업·복원 중… 창을 닫지 마세요.</p> }
        @if (error is not null) { <p class="text-danger" role="alert" data-testid="database-error">@error</p> }
    </section>
</section>

@code {
    private string retentionInput = "";
    private bool retentionLoaded;
    private bool savingRetention;
    private string? retentionStatus;
    private string? retentionError;

    protected override async Task OnInitializedAsync()
    {
        try { retentionInput = (await BackupSvc.GetRetentionDaysAsync()).ToString(); retentionLoaded = true; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "DB 자동 백업 설정 조회 실패");
            retentionError = "자동 백업 설정을 불러오지 못했습니다.";
        }
    }

    private void OnRetentionInput(ChangeEventArgs e)
    {
        retentionInput = e.Value?.ToString() ?? "";
        retentionError = null; // 값을 고치면 이전 실패를 해제해 재시도할 수 있게 한다.
        retentionStatus = null;
    }

    private async Task SaveRetentionAsync()
    {
        if (savingRetention || !int.TryParse(retentionInput?.Trim(), out var days)) return;
        savingRetention = true; retentionStatus = null; retentionError = null;
        try
        {
            await BackupSvc.SetRetentionDaysAsync(days);
            retentionStatus = $"백업 보관 기간을 {days}일로 저장했습니다.";
        }
        catch (AppException ex) { retentionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "DB 자동 백업 설정 저장 실패");
            retentionError = "저장하지 못했습니다. 다시 시도해 주세요.";
        }
        finally { savingRetention = false; }
    }

    private IBrowserFile? file;
    private bool busy;
    private bool confirming;
    private bool acknowledged;
    private string? error;
    private void SelectFile(InputFileChangeEventArgs e)
    {
        error = null; confirming = false; acknowledged = false; file = null;
        if (e.File.Size is <= 0 or > DatabaseBackupLimits.MaxFileBytes || !e.File.Name.EndsWith(".db", StringComparison.OrdinalIgnoreCase))
            error = "64MB 이하의 .db 파일 하나를 선택해 주세요.";
        else file = e.File;
    }
    private void Review() { confirming = true; acknowledged = false; error = null; }
    private void Cancel() { confirming = false; acknowledged = false; error = null; }
    private async Task RestoreAsync()
    {
        if (busy || file is null || !confirming || !acknowledged) return;
        busy = true; error = null;
        try
        {
            await using var stream = file.OpenReadStream(DatabaseBackupLimits.MaxFileBytes);
            await BackupSvc.RestoreAsync(stream, file.Name);
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
        }
        catch (AppException ex) { error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "DB 업로드·복원 요청 실패");
            error = "복원 결과를 확인하지 못했습니다. 연결을 확인하고 다시 로그인해 상태를 확인해 주세요.";
        }
        finally { busy = false; }
    }
}
