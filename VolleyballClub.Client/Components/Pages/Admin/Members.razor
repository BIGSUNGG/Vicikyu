@page "/admin/members"
@attribute [Authorize(Roles = "ADMIN")]

@inject MemberClient MemberSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Members> Logger
@using Microsoft.Extensions.Logging

<PageTitle>부원 관리 · 빅이큐</PageTitle>

<AdminNav Icon="/icons/users.svg" Title="부원 관리" Sub="@(isLoading ? "부원 정보를 불러오는 중…" : loadError is not null ? "부원 조회 실패" : $"부원 {page?.TotalCount ?? 0}명")" Active="members" />

<div class="card members-card" data-load-state="@LoadState">
    <h2 class="card-title">부원 목록</h2>

    <div class="field">
        <input class="form-control" type="search" placeholder="이름 / 학번 검색" @bind="search" @bind:event="oninput" @bind:after="SearchAsync" />
    </div>

    <div class="toolbar-row members-toolbar">
        <button type="button" class="btn-secondary" @onclick="() => showFilters = !showFilters">
            필터 @(ActiveFilterCount > 0 ? $"({ActiveFilterCount})" : "") @(showFilters ? "▲" : "▼")
        </button>
    </div>

    @if (showFilters)
    {
        <div class="reveal">
            <div class="filter-group">
                @foreach (var (status, label) in new[] { (MemberStatus.Active, "활동 부원"), (MemberStatus.Withdrawn, "탈퇴 부원"), (MemberStatus.Expelled, "퇴출 부원") })
                {
                    <button type="button" class="filter-btn @(selectedStatuses.Contains(status) ? "active" : "")"
                            @onclick="() => ToggleStatusAsync(status)">@label</button>
                }
            </div>

            <div class="toolbar-row">
                <div class="filter-group">
                    @foreach (var (value, label) in new[] { (true, "시트 연결"), (false, "시트 미연결") })
                    {
                        <button type="button" class="filter-btn @(sheetMapped == value ? "active" : "")"
                                @onclick="() => SetSheetFilterAsync(value)">@label</button>
                    }
                </div>
                <div class="filter-group">
                    @foreach (var (value, label) in new[] { (true, "회비 완납"), (false, "회비 미납") })
                    {
                        <button type="button" class="filter-btn @(feePaid == value ? "active" : "")"
                                @onclick="() => SetFeeFilterAsync(value)">@label</button>
                    }
                </div>
            </div>
        </div>
    }

    <div class="sort-strip">
            @foreach (var (field, label) in new[]
                     {
                         (MemberSortField.TotalAttendance, "총 출석"),
                         (MemberSortField.SemesterAttendance, "이번 학기 출석"),
                         (MemberSortField.MonthAttendance, "이번 달 출석"),
                     })
            {
                var selected = sort == field;
                <button type="button" class="sort-link @(selected ? "active" : "")" @onclick="() => ToggleSortAsync(field)">
                    @label@(selected ? (ascending ? " ↑" : " ↓") : "")
                </button>
            }
    </div>

    <div class="admin-load-region members-results" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
    @if (isLoading)
    {
        <span class="admin-load-status" role="status">부원 목록을 불러오는 중…</span>
        <div class="admin-load-skeleton" data-retained="@(page is not null ? "true" : "false")" aria-hidden="true">
            @if (page is { Items.Count: 0 })
            {
                <p class="member-meta"><span class="loading-placeholder">&nbsp;</span></p>
            }
            else
            {
                <div class="card-list split-2">
                    @for (var row = 0; row < (page?.Items.Count ?? 3); row++)
                    {
                        <div class="member-row">
                            <div>
                                <div class="member-name"><span class="loading-placeholder">&nbsp;</span></div>
                                <div class="member-meta"><span class="loading-placeholder" style="min-width:12em">&nbsp;</span></div>
                            </div>
                            <span class="loading-placeholder">&nbsp;</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (loadError is not null)
    {
        <div role="alert"><p>@loadError</p><button type="button" class="btn-primary" @onclick="ReadAsync">다시 불러오기</button></div>
    }
    else if (page is not null)
    {
    <div class="admin-load-values" aria-hidden="@(isLoading ? "true" : "false")">
    <div class="card-list split-2">
        @if (page is { Items.Count: 0 })
        {
            <p class="member-meta">조건에 맞는 부원이 없습니다.</p>
        }
        @foreach (var member in page?.Items ?? [])
        {
                <div class="member-row" style="cursor:pointer" tabindex="0"
                     @onclick='() => OpenDetailAsync(member.UserId)'
                     @onkeydown='e => { if (e.Key == "Enter") OpenDetailAsync(member.UserId); }'>
                <div>
                    <div class="member-name">
                        @if (member.Color is { } c)
                        {
                            <span class="member-dot" style="background:@c"></span>
                        }
                        @member.Name
                        @if (member.Status != MemberStatus.Active)
                        {
                            <span class="badge @(member.Status == MemberStatus.Expelled ? "badge-red" : "badge-gray")">@StatusLabel(member.Status)</span>
                        }
                    </div>
                    <div class="member-meta">@member.StudentNumber · @member.Department · 이번 학기 @(member.SemesterAttendance)회 · 이번 달 @(member.MonthAttendance)회</div>
                </div>
                <div style="margin-left:auto;display:flex;flex-direction:column;gap:4px;align-items:flex-end">
                    @if (!member.SheetMapped)
                    {
                        <span class="badge badge-red">시트 미연결</span>
                    }
                    <span class="badge @(member.Role == "ADMIN" ? "badge-orange" : "badge-gray")">@(member.Role == "ADMIN" ? "관리자" : "부원")</span>
                    <span class="badge @(member.FeePaidCurrent ? "badge-green" : "badge-red")">@(member.FeePaidCurrent ? "납부" : "미납")</span>
                </div>
            </div>
        }
    </div>

    @if (TotalPages > 1 || (page?.TotalCount ?? 0) > 0)
    {
        <div class="filter-group" style="margin-top:14px;align-items:center">
            <button type="button" class="filter-btn" disabled="@(pageNumber <= 1)" @onclick="() => GoToPageAsync(pageNumber - 1)">이전</button>
            @for (var p = 1; p <= TotalPages; p++)
            {
                var n = p;
                <button type="button" class="filter-btn @(n == pageNumber ? "active" : "")" @onclick="() => GoToPageAsync(n)">@n</button>
            }
            <button type="button" class="filter-btn" disabled="@(pageNumber >= TotalPages)" @onclick="() => GoToPageAsync(pageNumber + 1)">다음</button>
        </div>
    }
    </div>
    }
    </div>
</div>

<MemberBulkAdd OnAdded="ReloadAsync" />

@code {
    private bool isLoading = true;
    private bool isRefreshing;
    private string? loadError;
    private int loadGeneration;
    private string LoadState => isLoading ? "loading" : isRefreshing ? "refreshing" : loadError is not null ? "error" : "ready";
    private MemberPageDto? page;
    private string search = "";
    private HashSet<MemberStatus> selectedStatuses = [];
    private bool? sheetMapped;
    private bool? feePaid;
    private MemberSortField sort = MemberSortField.SemesterAttendance;
    private bool ascending;
    private int pageNumber = 1;
    private bool showFilters;

    private int TotalPages => page is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(page.TotalCount / (double)page.PageSize));

    private int ActiveFilterCount => selectedStatuses.Count
        + (sheetMapped is not null ? 1 : 0)
        + (feePaid is not null ? 1 : 0);

    protected override Task OnInitializedAsync() => ReadAsync();

    private Task ReadAsync() => ReloadAsync(showSkeleton: true);

    private Task ReloadAsync() => ReloadAsync(showSkeleton: false);

    private async Task ReloadAsync(bool showSkeleton)
    {
        var generation = ++loadGeneration;
        var request = new MemberPageRequest(
            string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            selectedStatuses.Count > 0 ? selectedStatuses.ToArray() : null,
            sheetMapped, feePaid, sort, ascending, pageNumber);
        isLoading = showSkeleton || page is null || isLoading;
        isRefreshing = !isLoading;
        loadError = null;
        try
        {
            var loaded = await MemberSvc.GetPageAsync(request)
                ?? throw new InvalidOperationException("부원 목록 응답이 없습니다.");
            if (generation != loadGeneration) return;
            page = loaded;
        }
        catch (AppException ex)
        {
            if (generation != loadGeneration) return;
            loadError = ex.Message;
            if (!showSkeleton) Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "부원 목록 조회 실패");
            if (generation != loadGeneration) return;
            loadError = "부원 목록을 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
            if (!showSkeleton) Snackbar.Add(loadError, Severity.Error);
        }
        finally
        {
            if (generation == loadGeneration)
            {
                isLoading = false;
                isRefreshing = false;
            }
        }
    }

    private void OpenDetailAsync(string userId) => Nav.NavigateTo($"/admin/members/{userId}");

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await ReadAsync();
    }

    private async Task ToggleStatusAsync(MemberStatus status)
    {
        if (!selectedStatuses.Remove(status))
        {
            selectedStatuses.Add(status);
        }

        pageNumber = 1;
        await ReadAsync();
    }

    private async Task SetSheetFilterAsync(bool? value)
    {
        // 토글 — 활성 버튼을 다시 누르면 해제(전체)
        sheetMapped = sheetMapped == value ? null : value;
        pageNumber = 1;
        await ReadAsync();
    }

    private async Task SetFeeFilterAsync(bool? value)
    {
        feePaid = feePaid == value ? null : value;
        pageNumber = 1;
        await ReadAsync();
    }

    private async Task ToggleSortAsync(MemberSortField value)
    {
        // 같은 정렬 텍스트를 다시 누르면 오름/내림 전환, 다른 텍스트는 내림차순부터 시작
        if (sort == value)
        {
            ascending = !ascending;
        }
        else
        {
            sort = value;
            ascending = false;
        }

        pageNumber = 1;
        await ReadAsync();
    }

    private async Task GoToPageAsync(int n)
    {
        pageNumber = Math.Clamp(n, 1, TotalPages);
        await ReadAsync();
    }

    private static string StatusLabel(MemberStatus status) => status switch
    {
        MemberStatus.Withdrawn => "탈퇴",
        MemberStatus.Expelled => "퇴출",
        _ => "활동",
    };

}
