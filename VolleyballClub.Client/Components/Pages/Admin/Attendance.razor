@page "/admin/attendance"
@attribute [Authorize(Roles = "ADMIN")]
@implements IAsyncDisposable

@inject AttendanceClient AttendanceSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Attendance> Logger
@using Microsoft.Extensions.Logging

<PageTitle>출석 관리 · 빅이큐</PageTitle>

<AdminNav Icon="/icons/clipboard.svg" Title="출석 관리" Sub="직접 출석 · 취소 (토글)" Active="attendance"
          Badge="@(isLoading ? "\u00a0" : hasLoaded ? $"출석 {attendedCount}명" : null)"
          BadgeClass="@(isLoading ? "badge-green loading-placeholder" : "badge-green")" />

<div class="card attendance-card" aria-busy="@(isLoading ? "true" : "false")" data-load-state="@LoadState">
    <div class="field">
        <input class="form-control" type="search" placeholder="이름 / 학번 검색" @bind="search" @bind:after="OnSearchSet" />
    </div>
    <div class="admin-load-region">
        @if (isLoading)
        {
            <span class="admin-load-status" role="status">출석 정보를 불러오는 중…</span>
            <div class="admin-load-skeleton" data-retained="@(hasLoaded ? "true" : "false")" aria-hidden="true">
                <p class="member-meta">오늘 출석 <span class="loading-placeholder">&nbsp;</span> / 전체 <span class="loading-placeholder">&nbsp;</span></p>
                <div class="section-divider"><span class="loading-placeholder">&nbsp;</span></div>
                @if (hasLoaded && visibleMembers.Count == 0)
                {
                    <p class="empty"><span class="loading-placeholder">&nbsp;</span></p>
                }
                else
                {
                    <div class="card-list split-2">
                        @for (var i = 0; i < (hasLoaded ? visibleMembers.Count : 3); i++)
                        {
                            <div class="member-row">
                                <span class="loading-placeholder" style="width:46px;height:26px;border-radius:999px">&nbsp;</span>
                                <div>
                                    <div class="member-name"><span class="loading-placeholder">&nbsp;</span></div>
                                    <div class="member-meta"><span class="loading-placeholder">&nbsp;</span></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (loadError is not null)
        {
            <div role="alert">
                <p>@loadError</p>
                <button type="button" class="btn-primary" @onclick="ReadAsync">다시 불러오기</button>
            </div>
        }
        else if (hasLoaded)
        {
            <div class="admin-load-values" aria-hidden="@(isLoading ? "true" : "false")">
                <p class="member-meta">오늘 출석 @(attendedCount)명 / 전체 @(members.Count)명</p>
                @if (searched)
                {
                    <div class="section-divider">검색 결과</div>
                }
                else
                {
                    <div class="section-divider">오늘 출석 @(attendedCount)명</div>
                }
                <AttendanceMemberList Members="visibleMembers" OnToggled="ToggleAsync" />
            </div>
            <div class="attendance-save-row">
                <button type="button" class="btn-primary" data-testid="attendance-save"
                        disabled="@(isSaving || teamConfirm is not null || pendingCount == 0)"
                        @onclick="SaveAsync">
                    @(isSaving ? "저장 중…" : pendingCount == 0 ? "저장" : $"변경 {pendingCount}건 저장")
                </button>
            </div>
        }
    </div>
</div>

@if (leaveTarget is not null)
{
    <div class="confirm-overlay" @onclick="() => leaveTarget = null">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>저장하지 않은 변경</h3>
            <p>출석 변경 @(pendingCount)건이 아직 저장되지 않았습니다. 이 페이지를 벗어나면 변경이 사라집니다.</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="() => leaveTarget = null">계속 편집</button>
                <button type="button" class="btn-danger" @onclick="ConfirmLeaveAsync">나가기</button>
            </div>
        </div>
    </div>
}

@if (teamConfirm is not null)
{
    <div class="confirm-overlay" @onclick="CancelTeamConfirm">
        <div class="confirm-box" @onclick:stopPropagation>
            <h3>팀 편성 영향 확인</h3>
            <p>다음 부원의 출석 취소는 팀에서도 제외됩니다: @(string.Join(", ", teamConfirm.Select(m => m.Name)))</p>
            <div class="btn-row">
                <button type="button" class="btn-ghost" @onclick="CancelTeamConfirm">취소 유지</button>
                <button type="button" class="btn-primary" @onclick="ConfirmTeamImpactAsync">팀에서도 제외하고 취소</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool hasLoaded;
    private bool isRefreshing;
    private bool isSaving;
    private bool leaving;
    private string? loadError;
    private int loadGeneration;
    private string LoadState => isLoading ? "loading" : isRefreshing ? "refreshing" : loadError is not null ? "error" : "ready";
    private List<AttendanceMemberDto> members = [];
    /// <summary>마지막 로드/저장 시점의 출석 여부 — 화면 토글과의 diff로 미저장 변경을 추적한다.</summary>
    private Dictionary<string, bool> savedState = [];
    private string search = "";
    private bool searched;
    private string? leaveTarget;
    private List<AttendanceMemberDto>? teamConfirm;
    private int attendedCount;
    private IDisposable? navGuard;
    private IJSObjectReference? guardModule;
    private bool unloadGuardOn;
    private bool disposed;

    private int pendingCount => members.Count(m => savedState.TryGetValue(m.UserId, out var saved) && saved != m.IsAttended);

    private List<AttendanceMemberDto> visibleMembers => searched
        ? members.Where(m => m.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || m.StudentNumber.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList()
        : members;

    protected override Task OnInitializedAsync() => ReadAsync();

    protected override void OnInitialized()
    {
        // 미저장 변경이 있는 상태의 내부 내비게이션을 가로채 이탈 확인창을 띄운다.
        navGuard = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        navGuard?.Dispose();
        try
        {
            if (guardModule is not null)
            {
                if (unloadGuardOn) await guardModule.InvokeVoidAsync("disable");
                await guardModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (disposed || leaving || pendingCount == 0) return ValueTask.CompletedTask;
        context.PreventNavigation();
        leaveTarget = context.TargetLocation;
        // 이 콜백은 자동 재렌더가 없다 — 확인창을 그리기 위해 직접 렌더를 요청한다
        InvokeAsync(StateHasChanged);
        return ValueTask.CompletedTask;
    }

    private async Task ConfirmLeaveAsync()
    {
        var target = leaveTarget;
        leaveTarget = null;
        if (target is null) return;
        leaving = true; // 가드 통과 — 미저장 변경 폐기 후 이동
        await SetUnloadGuardAsync(enabled: false);
        Navigation.NavigateTo(target);
    }

    private async Task SetUnloadGuardAsync(bool enabled)
    {
        if (guardModule is null && !enabled) return;
        try
        {
            guardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/attendance-guard.js");
            await guardModule.InvokeVoidAsync(enabled ? "enable" : "disable");
            unloadGuardOn = enabled;
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>미저장 변경 유무에 맞춰 새로고침·닫기 가드를 켜고 끈다.</summary>
    private Task SyncUnloadGuardAsync()
    {
        var need = pendingCount > 0;
        return need == unloadGuardOn ? Task.CompletedTask : SetUnloadGuardAsync(need);
    }

    private Task ReadAsync() => LoadAsync(showSkeleton: true);

    private Task LoadAsync() => LoadAsync(showSkeleton: false);

    private async Task LoadAsync(bool showSkeleton)
    {
        var generation = ++loadGeneration;
        isLoading = showSkeleton || !hasLoaded || isLoading;
        isRefreshing = !isLoading;
        loadError = null;
        try
        {
            var loaded = await AttendanceSvc.GetTodayMembersAsync()
                ?? throw new InvalidOperationException("출석 목록 응답이 없습니다.");
            var loadedCount = loaded.Count(m => m.IsAttended);
            if (generation != loadGeneration) return;
            members = loaded;
            savedState = loaded.ToDictionary(m => m.UserId, m => m.IsAttended);
            attendedCount = loadedCount;
            hasLoaded = true;
        }
        catch (AppException ex)
        {
            if (generation != loadGeneration) return;
            loadError = ex.Message;
            if (!showSkeleton) Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "출석 정보 조회 실패");
            if (generation != loadGeneration) return;
            loadError = "출석 정보를 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요.";
            if (!showSkeleton) Snackbar.Add(loadError, Severity.Error);
        }
        finally
        {
            if (generation == loadGeneration)
            {
                isLoading = false;
                isRefreshing = false;
                await SyncUnloadGuardAsync();
            }
        }
    }

    private void OnSearchSet() => searched = search.Trim().Length > 0;

    /// <summary>토글 시 목록이 재정렬되지 않도록 진입 시 순서를 유지한 채 해당 부원만 갱신한다.</summary>
    private void MarkAttended(string userId, bool attended)
    {
        members = [.. members.Select(m => m.UserId == userId
            ? m with
            {
                IsAttended = attended,
                CheckedAt = attended ? DateTime.UtcNow : null,
                AttendanceType = attended ? Domain.Enums.AttendanceType.Admin : null,
            }
            : m)];
        attendedCount = members.Count(m => m.IsAttended);
    }

    /// <summary>토글은 화면 상태만 바꾼다 — DB 저장은 하단 저장 버튼에서 일괄 수행.</summary>
    private async Task ToggleAsync((AttendanceMemberDto Member, bool Checked) toggle)
    {
        MarkAttended(toggle.Member.UserId, toggle.Checked);
        await SyncUnloadGuardAsync();
    }

    /// <summary>미저장 변경 전체를 저장한다. 부원별 성공/실패가 서로 격리되고, 팀 편성 영향 취소는 확인 후 재시도한다.</summary>
    private async Task SaveAsync()
    {
        if (isSaving || teamConfirm is not null) return;
        var changes = members
            .Where(m => savedState.TryGetValue(m.UserId, out var saved) && saved != m.IsAttended)
            .Select(m => (Member: m, Now: m.IsAttended))
            .ToList();
        if (changes.Count == 0) return;

        isSaving = true;
        try
        {
            var teamImpact = new List<AttendanceMemberDto>();
            var failures = new List<string>();
            var saved = 0;
            foreach (var change in changes)
            {
                try
                {
                    if (change.Now)
                    {
                        await AttendanceSvc.AdminAddAsync(change.Member.UserId);
                    }
                    else
                    {
                        await AttendanceSvc.AdminCancelAsync(change.Member.UserId);
                    }
                    savedState[change.Member.UserId] = change.Now;
                    saved++;
                }
                catch (ConflictException ex) when (!change.Now && ex.Message.Contains("팀 편성이 완료"))
                {
                    // 팀 편성 영향 — 확인창을 띄우고 승인되면 confirmTeamImpact로 재시도한다.
                    teamImpact.Add(change.Member);
                }
                catch (AppException ex)
                {
                    failures.Add($"{change.Member.Name}: {ex.Message}");
                }
                catch (Exception)
                {
                    failures.Add($"{change.Member.Name}: 네트워크 오류로 저장하지 못했습니다.");
                }
            }

            if (teamImpact.Count > 0)
            {
                teamConfirm = teamImpact;
            }
            ReportSaveResult(saved, failures);
        }
        finally
        {
            isSaving = false;
            await SyncUnloadGuardAsync();
            StateHasChanged();
        }
    }

    private void CancelTeamConfirm() => teamConfirm = null;

    private async Task ConfirmTeamImpactAsync()
    {
        var targets = teamConfirm;
        teamConfirm = null;
        if (targets is null) return;

        var failures = new List<string>();
        var saved = 0;
        foreach (var member in targets)
        {
            try
            {
                await AttendanceSvc.AdminCancelAsync(member.UserId, confirmTeamImpact: true);
                savedState[member.UserId] = false;
                saved++;
            }
            catch (AppException ex)
            {
                failures.Add($"{member.Name}: {ex.Message}");
            }
            catch (Exception)
            {
                failures.Add($"{member.Name}: 네트워크 오류로 저장하지 못했습니다.");
            }
        }
        ReportSaveResult(saved, failures);
        await SyncUnloadGuardAsync();
    }

    private static string Summarize(List<string> failures) =>
        string.Join(" · ", failures.Take(3)) + (failures.Count > 3 ? $" 외 {failures.Count - 3}건" : "");

    private void ReportSaveResult(int saved, List<string> failures)
    {
        if (saved > 0)
        {
            Snackbar.Add($"출석 {saved}건 저장 완료", Severity.Success);
        }
        if (failures.Count > 0)
        {
            Snackbar.Add($"저장 실패 — {Summarize(failures)}", Severity.Error);
        }
    }
}
