@if (Members.Count == 0)
{
    <p class="empty">부원이 없습니다.</p>
}
else
{
    <div class="card-list split-2">
        @foreach (var member in Members)
        {
            <label class="member-row @(member.IsAttended ? "" : "unattended")" @key="member.UserId">
                @* 네이티브 토글은 그대로 두고 클릭값을 반전해 알린다 — 토글은 화면 전용, 저장은 하단 버튼에서만 *@
                <input type="checkbox" checked="@member.IsAttended"
                       @onclick="() => ToggleAsync(member, !member.IsAttended)" />
                <div>
                    <div class="member-name">@member.Name</div>
                    <div class="member-meta">@member.StudentNumber · @member.Department</div>
                </div>
                @if (member.IsAttended)
                {
                    <span class="member-time">
                        @(Domain.KstClock.ToKstTimeString(member.CheckedAt ?? DateTime.MinValue))
                        @(member.AttendanceType == Domain.Enums.AttendanceType.Admin ? "(관리자)" : "")
                    </span>
                }
            </label>
        }
    </div>
}

@code {
    [Parameter]
    public List<AttendanceMemberDto> Members { get; set; } = [];

    [Parameter]
    public EventCallback<(AttendanceMemberDto Member, bool Checked)> OnToggled { get; set; }

    private async Task ToggleAsync(AttendanceMemberDto member, bool value)
    {
        await OnToggled.InvokeAsync((member, value));
    }
}
